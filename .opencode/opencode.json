{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["./.opencode/plugin/auto-compile.js"],
  "mcp": {
    "unity-MCP": {
      "type": "remote",
      "url": "http://127.0.0.1:8080/mcp"
    },
    "serena": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server"
      ],
      "enabled": true
    }
  },
  "lsp": {
    "csharp": {
      "command": ["roslyn-language-server", "--stdio"],
      "extensions": [".cs"]
    }
  }
}
