{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["./.opencode/plugin/auto-compile.js"],
  "mcp": {
    "unity-MCP": {
      "type": "remote",
      "url": "__UNITY_MCP_URL__"
    }
  },
  "lsp": {
    "csharp": {
      "command": ["roslyn-language-server", "--stdio"],
      "extensions": [".cs"]
    }
  }
}
