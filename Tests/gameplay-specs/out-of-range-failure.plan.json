{
  "schemaVersion": 1,
  "scenarioName": "SkillGraph.TargetOutOfRangePreventsAbilityUse",
  "requiredAdapters": [
    "Skill"
  ],
  "setupActions": [
    {
      "kind": "createSkillTestWorld",
      "parameters": {},
      "adapter": "Skill"
    },
    {
      "kind": "createSkillGraph",
      "parameters": {
        "alias": "graph",
        "graphKind": "singleTargetDamage",
        "baseDamage": 7
      },
      "adapter": "Skill"
    },
    {
      "kind": "createSkillAbilityConfig",
      "parameters": {
        "alias": "ability",
        "graphAlias": "graph",
        "manaCost": 3,
        "targetRange": 2
      },
      "adapter": "Skill"
    },
    {
      "kind": "createCell",
      "parameters": {
        "alias": "casterCell",
        "x": 0,
        "y": 0
      },
      "adapter": "Skill"
    },
    {
      "kind": "createCell",
      "parameters": {
        "alias": "targetCell",
        "x": 4,
        "y": 0
      },
      "adapter": "Skill"
    },
    {
      "kind": "createUnit",
      "parameters": {
        "alias": "caster",
        "playerNumber": 0,
        "health": 10,
        "maxHealth": 10,
        "mana": 10,
        "cellAlias": "casterCell"
      },
      "adapter": "Skill"
    },
    {
      "kind": "createUnit",
      "parameters": {
        "alias": "target",
        "playerNumber": 1,
        "health": 10,
        "maxHealth": 10,
        "cellAlias": "targetCell"
      },
      "adapter": "Skill"
    },
    {
      "kind": "setTurnContext",
      "parameters": {
        "currentPlayerNumber": 0,
        "playableUnitAliases": [
          "caster"
        ]
      },
      "adapter": "Skill"
    },
    {
      "kind": "createSkillAbility",
      "parameters": {
        "alias": "abilityImpl",
        "configAlias": "ability",
        "ownerAlias": "caster"
      },
      "adapter": "Skill"
    },
    {
      "kind": "selectAbility",
      "parameters": {
        "abilityAlias": "abilityImpl"
      },
      "adapter": "Skill"
    }
  ],
  "runtimeActions": [
    {
      "kind": "executeAbilityOnTarget",
      "target": "target",
      "parameters": {
        "abilityAlias": "abilityImpl"
      },
      "adapter": "Skill"
    }
  ],
  "assertionPlans": [
    {
      "kind": "executionStateEquals",
      "expected": "Failed",
      "parameters": {},
      "adapter": "Skill"
    },
    {
      "kind": "unitManaEquals",
      "target": "caster",
      "expected": 10,
      "parameters": {},
      "adapter": "Skill"
    },
    {
      "kind": "lastErrorContains",
      "expected": "Target out of range",
      "parameters": {},
      "adapter": "Skill"
    },
    {
      "kind": "stepMessageContains",
      "expected": "Failed",
      "parameters": {},
      "adapter": "Skill"
    }
  ],
  "timeoutMs": 10000,
  "probeRequests": [
    {
      "adapter": "Skill",
      "kind": "executionStateEquals",
      "parameters": {}
    },
    {
      "adapter": "Skill",
      "kind": "unitManaEquals",
      "target": "caster",
      "parameters": {}
    },
    {
      "adapter": "Skill",
      "kind": "lastErrorContains",
      "parameters": {}
    },
    {
      "adapter": "Skill",
      "kind": "stepMessageContains",
      "parameters": {}
    }
  ]
}
