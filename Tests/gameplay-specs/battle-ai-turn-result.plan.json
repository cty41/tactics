{
  "schemaVersion": 1,
  "scenarioName": "Battle.BattleAiTurnResult",
  "requiredAdapters": [
    "Battle"
  ],
  "setupActions": [
    {
      "adapter": "Battle",
      "kind": "bindBattleController",
      "parameters": {}
    },
    {
      "adapter": "Battle",
      "kind": "createAiBrain",
      "parameters": {
        "brainAssetAlias": "attackBrain",
        "brainType": "attack"
      }
    }
  ],
  "runtimeActions": [
    {
      "adapter": "Battle",
      "kind": "executeAI",
      "parameters": {
        "unitAlias": "p1_0",
        "brainAssetAlias": "attackBrain"
      }
    }
  ],
  "assertionPlans": [
    {
      "adapter": "Battle",
      "kind": "aiTurnSucceededEquals",
      "expected": true,
      "parameters": {}
    },
    {
      "adapter": "Battle",
      "kind": "aiTurnUsedFallbackEquals",
      "expected": false,
      "parameters": {}
    }
  ],
  "timeoutMs": 15000,
  "probeRequests": [
    {
      "adapter": "Battle",
      "kind": "aiTurnSucceededEquals",
      "parameters": {}
    },
    {
      "adapter": "Battle",
      "kind": "aiTurnUsedFallbackEquals",
      "parameters": {}
    }
  ]
}
