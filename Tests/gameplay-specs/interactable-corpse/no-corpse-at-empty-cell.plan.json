{
  "schemaVersion": 1,
  "scenarioName": "InteractableCorpse.NoInteractableCorpseAtEmptyCell",
  "requiredAdapters": [
    "Battle"
  ],
  "setupActions": [
    {
      "adapter": "Battle",
      "kind": "bindBattleController",
      "parameters": {}
    },
    {
      "adapter": "Skill",
      "kind": "createCell",
      "parameters": {
        "alias": "cell_1_1",
        "x": 1,
        "y": 1
      }
    }
  ],
  "runtimeActions": [
    {
      "adapter": "Battle",
      "kind": "advanceTurn",
      "parameters": {}
    }
  ],
  "assertionPlans": [
    {
      "adapter": "Battle",
      "kind": "interactableCorpseExistsAt",
      "target": "cell_1_1",
      "expected": false,
      "parameters": {}
    },
    {
      "adapter": "Battle",
      "kind": "cellOccupiedByInteractable",
      "target": "cell_1_1",
      "expected": false,
      "parameters": {}
    }
  ],
  "timeoutMs": 10000,
  "probeRequests": [
    {
      "adapter": "Battle",
      "kind": "interactableCorpseExistsAt",
      "target": "cell_1_1",
      "parameters": {}
    },
    {
      "adapter": "Battle",
      "kind": "cellOccupiedByInteractable",
      "target": "cell_1_1",
      "parameters": {}
    }
  ]
}
