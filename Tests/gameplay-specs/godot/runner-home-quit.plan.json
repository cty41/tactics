{
  "schemaVersion": 2,
  "runtime": "Godot",
  "scenarioName": "GodotGameplayRunner.RunnerHomeQuit",
  "requiredAdapters": [
    "PlayerInput",
    "UI"
  ],
  "requiredCapabilities": [
    "action:clickPointerTarget",
    "action:waitForPlayerObservable",
    "assertion:runtimeHasNoErrors",
    "setup:initializePlayerInput"
  ],
  "setupActions": [
    {
      "adapter": "PlayerInput",
      "kind": "initializePlayerInput",
      "parameters": {}
    }
  ],
  "runtimeActions": [
    {
      "adapter": "PlayerInput",
      "kind": "waitForPlayerObservable",
      "target": "Quit",
      "parameters": {
        "observable": "uiElement",
        "elementName": "Quit",
        "maximumFrames": 180
      }
    },
    {
      "adapter": "PlayerInput",
      "kind": "clickPointerTarget",
      "target": "Quit",
      "parameters": {
        "targetKind": "UiElement"
      }
    }
  ],
  "assertionPlans": [
    {
      "adapter": "UI",
      "kind": "runtimeHasNoErrors",
      "expected": true,
      "parameters": {}
    }
  ],
  "timeoutMs": 30000,
  "probeRequests": [
    {
      "adapter": "UI",
      "kind": "runtimeHasNoErrors",
      "parameters": {}
    }
  ],
  "saveIsolation": {
    "root": "user://qa-runner",
    "protectProductionSave": true
  },
  "watchdog": {
    "stepTimeoutMs": 30000,
    "battleRoundLimit": 80,
    "scenarioTimeoutMs": 300000,
    "noProgressLimit": 2
  }
}
