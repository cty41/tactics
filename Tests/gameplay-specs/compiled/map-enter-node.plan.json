{
  "schemaVersion": 1,
  "scenarioName": "Map.MapEnterNode",
  "requiredAdapters": [
    "Map"
  ],
  "setupActions": [
    {
      "adapter": "Map",
      "kind": "loadRoguelikeMap",
      "parameters": {
        "mapConfigPath": "Assets/Tactics/RoguelikeMap/MapConfigs/DefaultRogueLikeMapConfig.asset",
        "useFallbackMap": true
      }
    }
  ],
  "runtimeActions": [
    {
      "adapter": "Map",
      "kind": "enterNode",
      "parameters": {
        "nodeId": "start_node"
      }
    },
    {
      "adapter": "Map",
      "kind": "completeNode",
      "parameters": {
        "nodeId": "start_node"
      }
    }
  ],
  "assertionPlans": [
    {
      "adapter": "Map",
      "kind": "mapIsActive",
      "expected": true,
      "parameters": {}
    },
    {
      "adapter": "Map",
      "kind": "visitedNodeCountEquals",
      "expected": 1,
      "parameters": {}
    },
    {
      "adapter": "Map",
      "kind": "nodeIsVisited",
      "target": "start_node",
      "expected": true,
      "parameters": {}
    }
  ],
  "timeoutMs": 15000,
  "probeRequests": [
    {
      "adapter": "Map",
      "kind": "mapIsActive",
      "parameters": {}
    },
    {
      "adapter": "Map",
      "kind": "visitedNodeCountEquals",
      "parameters": {}
    },
    {
      "adapter": "Map",
      "kind": "nodeIsVisited",
      "target": "start_node",
      "parameters": {}
    }
  ]
}
