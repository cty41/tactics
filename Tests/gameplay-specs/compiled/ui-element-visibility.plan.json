{
  "schemaVersion": 1,
  "scenarioName": "UI.UiElementVisibility",
  "requiredAdapters": [
    "UI"
  ],
  "setupActions": [],
  "runtimeActions": [
    {
      "adapter": "UI",
      "kind": "openUI",
      "parameters": {
        "uiId": "Home"
      }
    },
    {
      "adapter": "UI",
      "kind": "clickElement",
      "parameters": {
        "elementName": "NewGameButton"
      }
    }
  ],
  "assertionPlans": [
    {
      "adapter": "UI",
      "kind": "elementVisible",
