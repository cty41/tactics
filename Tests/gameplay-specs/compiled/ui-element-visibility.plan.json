      "parameters": {}
    },
    {
      "adapter": "UI",
      "kind": "elementEnabled",
      "target": "NewGameButton",
      "expected": true,
      "parameters": {}
    }
  ],
  "timeoutMs": 10000,
  "probeRequests": [
    {
      "adapter": "UI",
      "kind": "elementVisible",
      "target": "NewGameButton",
      "parameters": {}
    },
    {
      "adapter": "UI",
      "kind": "elementEnabled",
      "target": "NewGameButton",
      "parameters": {}
    }
  ]
