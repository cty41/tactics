{
  "schemaVersion": 1,
  "scenarioName": "Map.MapBattleNode",
  "requiredAdapters": [
    "Map",
    "Battle",
    "Skill"
  ],
  "setupActions": [
    {
      "adapter": "Map",
      "kind": "loadRoguelikeMap",
      "parameters": {
        "mapConfigPath": "Assets/Tactics/RoguelikeMap/MapConfigs/DefaultMapConfig.asset"
      }
    },
    {
      "adapter": "Battle",
      "kind": "bindBattleController",
      "parameters": {}
    },
    {
      "adapter": "Skill",
      "kind": "createSkillGraph",
      "parameters": {
        "alias": "attackGraph",
        "graphKind": "singleTargetDamage",
        "baseDamage": 50
      }
    }
  ],
  "runtimeActions": [
    {
      "adapter": "Map",
      "kind": "enterNode",
      "parameters": {
        "nodeId": "battle_node_1"
      }
    },
    {
      "adapter": "Battle",
      "kind": "executeBattleSkillGraph",
      "parameters": {
        "graphAlias": "attackGraph",
        "casterAlias": "p1_0",
        "targetAlias": "p2_0"
      }
    },
    {
      "adapter": "Map",
      "kind": "completeNode",
      "parameters": {
        "nodeId": "battle_node_1"
      }
    }
  ],
  "assertionPlans": [
    {
      "adapter": "Map",
      "kind": "mapIsActive",
      "expected": true,
      "parameters": {}
    },
    {
      "adapter": "Battle",
      "kind": "battleIsActive",
      "expected": true,
      "parameters": {}
    },
    {
      "adapter": "Map",
      "kind": "nodeIsVisited",
      "target": "battle_node_1",
      "expected": true,
      "parameters": {}
    },
    {
      "adapter": "Map",
      "kind": "visitedNodeCountEquals",
      "expected": 1,
      "parameters": {}
    }
  ],
  "timeoutMs": 20000,
  "probeRequests": [
    {
      "adapter": "Map",
      "kind": "mapIsActive",
      "parameters": {}
    },
    {
      "adapter": "Battle",
      "kind": "battleIsActive",
      "parameters": {}
    },
    {
      "adapter": "Map",
      "kind": "nodeIsVisited",
      "target": "battle_node_1",
      "parameters": {}
    },
    {
      "adapter": "Map",
      "kind": "visitedNodeCountEquals",
      "parameters": {}
    }
  ]
}
