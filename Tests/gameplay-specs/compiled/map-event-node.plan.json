{
  "schemaVersion": 1,
  "scenarioName": "Map.MapEventNode",
  "requiredAdapters": [
    "Map"
  ],
  "setupActions": [
    {
      "adapter": "Map",
      "kind": "loadRoguelikeMap",
      "parameters": {
        "mapConfigPath": "Assets/Tactics/RoguelikeMap/MapConfigs/DefaultMapConfig.asset"
      }
    }
  ],
  "runtimeActions": [
    {
      "adapter": "Map",
      "kind": "enterNode",
      "parameters": {
        "nodeId": "mystery_node_1"
      }
    },
    {
      "adapter": "Map",
      "kind": "triggerEvent",
      "parameters": {
        "eventId": "cursed_chest_001"
      }
    },
    {
      "adapter": "Map",
      "kind": "completeNode",
      "parameters": {
        "nodeId": "mystery_node_1"
      }
    }
  ],
  "assertionPlans": [
    {
      "adapter": "Map",
      "kind": "mapIsActive",
      "expected": true,
      "parameters": {}
    },
    {
      "adapter": "Map",
      "kind": "nodeIsVisited",
      "target": "mystery_node_1",
      "expected": true,
      "parameters": {}
    },
    {
      "adapter": "Map",
      "kind": "visitedNodeCountEquals",
      "expected": 1,
      "parameters": {}
    }
  ],
  "timeoutMs": 15000,
  "probeRequests": [
    {
      "adapter": "Map",
      "kind": "mapIsActive",
      "parameters": {}
    },
    {
      "adapter": "Map",
      "kind": "nodeIsVisited",
      "target": "mystery_node_1",
      "parameters": {}
    },
    {
      "adapter": "Map",
      "kind": "visitedNodeCountEquals",
      "parameters": {}
    }
  ]
}
