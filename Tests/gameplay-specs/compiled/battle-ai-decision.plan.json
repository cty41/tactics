{
  "schemaVersion": 1,
  "scenarioName": "Battle.BattleAiDecision",
  "requiredAdapters": [
    "Battle"
  ],
  "setupActions": [
    {
      "adapter": "Battle",
      "kind": "bindBattleController",
      "parameters": {}
    },
    {
      "adapter": "Battle",
      "kind": "createAiBrain",
      "parameters": {
        "brainAssetAlias": "attackBrain",
        "brainType": "attack"
      }
    }
  ],
  "runtimeActions": [
    {
      "adapter": "Battle",
      "kind": "advanceTurn",
      "parameters": {}
    },
    {
      "adapter": "Battle",
      "kind": "executeAI",
      "parameters": {
        "unitAlias": "p1_0",
        "brainAssetAlias": "attackBrain"
      }
    }
  ],
  "assertionPlans": [
    {
      "adapter": "Battle",
      "kind": "battleIsActive",
      "expected": true,
      "parameters": {}
    },
    {
      "adapter": "Battle",
      "kind": "currentRoundEquals",
      "expected": 1,
      "parameters": {}
    }
  ],
  "timeoutMs": 15000,
  "probeRequests": [
    {
      "adapter": "Battle",
      "kind": "battleIsActive",
      "parameters": {}
    },
    {
      "adapter": "Battle",
      "kind": "currentRoundEquals",
      "parameters": {}
    }
  ]
}
