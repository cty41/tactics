{
  "schemaVersion": 1,
  "scenarioName": "Battle.BuffIconCountDisplay",
  "requiredAdapters": [
    "Battle",
    "UI"
  ],
  "setupActions": [
    {
      "adapter": "Battle",
      "kind": "bindBattleController",
      "parameters": {}
    },
    {
      "adapter": "Battle",
      "kind": "useRealAssets",
      "parameters": {}
    }
  ],
  "runtimeActions": [
    {
      "adapter": "Battle",
      "kind": "addBuff",
      "parameters": {
        "unitAlias": "p1_0",
        "buffName": "Frozen",
        "duration": 3,
        "configPath": "Assets/Tactics/Battle/Buffs/Frozen.asset"
      }
    },
    {
      "adapter": "Battle",
      "kind": "addBuff",
      "parameters": {
        "unitAlias": "p1_0",
        "buffName": "Frozen",
        "duration": 3,
        "configPath": "Assets/Tactics/Battle/Buffs/Frozen.asset"
      }
    }
  ],
  "assertionPlans": [
    {
      "adapter": "Battle",
      "kind": "unitHasBuff",
      "target": "p1_0",
      "expected": "Frozen",
      "parameters": {}
    },
    {
      "adapter": "Battle",
      "kind": "unitBuffDurationEquals",
      "target": "p1_0",
      "expected": 3,
      "parameters": {
        "buffName": "Frozen"
      }
    },
    {
      "adapter": "UI",
      "kind": "elementExists",
      "target": "buff-icon-Frozen",
      "expected": true,
      "parameters": {}
    },
    {
      "adapter": "UI",
      "kind": "elementText",
      "target": "buff-icon-Frozen >> turn-count",
      "expected": "3",
      "parameters": {}
    }
  ],
  "timeoutMs": 15000,
  "probeRequests": [
    {
      "adapter": "Battle",
      "kind": "unitHasBuff",
      "target": "p1_0",
      "parameters": {}
    },
    {
      "adapter": "Battle",
      "kind": "unitBuffDurationEquals",
      "target": "p1_0",
      "parameters": {
        "buffName": "Frozen"
      }
    },
    {
      "adapter": "UI",
      "kind": "elementExists",
      "target": "buff-icon-Frozen",
      "parameters": {}
    },
    {
      "adapter": "UI",
      "kind": "elementText",
      "target": "buff-icon-Frozen >> turn-count",
      "parameters": {}
    }
  ]
}
