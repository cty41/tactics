{
  "schemaVersion": 1,
  "scenarioName": "Battle.BattleAreaSkillHit",
  "requiredAdapters": [
    "Battle",
    "Skill"
  ],
  "setupActions": [
    {
      "adapter": "Battle",
      "kind": "bindBattleController",
      "parameters": {}
    },
    {
      "adapter": "Skill",
      "kind": "createSkillGraph",
      "parameters": {
        "alias": "fireballGraph",
        "graphKind": "areaDamage",
        "baseDamage": 30,
        "isRanged": true,
        "minRange": 1,
        "maxRange": 3,
        "aoeRadius": 1
      }
    }
  ],
  "runtimeActions": [
    {
      "adapter": "Battle",
      "kind": "executeBattleSkillGraph",
      "parameters": {
        "graphAlias": "fireballGraph",
        "casterAlias": "p1_0",
        "targetPointAlias": "cell_1_0"
      }
    }
  ],
  "assertionPlans": [
    {
      "adapter": "Battle",
      "kind": "unitHealthEquals",
      "target": "p1_0",
      "expected": 100,
      "parameters": {}
    },
    {
      "adapter": "Battle",
      "kind": "battleIsActive",
      "expected": true,
      "parameters": {}
    }
  ],
  "timeoutMs": 15000,
  "probeRequests": [
    {
      "adapter": "Battle",
      "kind": "unitHealthEquals",
      "target": "p1_0",
      "parameters": {}
    },
    {
      "adapter": "Battle",
      "kind": "battleIsActive",
      "parameters": {}
    }
  ]
}
