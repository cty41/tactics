{
  "schemaVersion": 1,
  "scenarioName": "UI.AmazonMultiStabUiFlow",
  "requiredAdapters": [
    "Battle",
    "UI"
  ],
  "setupActions": [
    {
      "adapter": "Battle",
      "kind": "bindBattleController",
      "parameters": {}
    }
  ],
  "runtimeActions": [
    {
      "adapter": "Battle",
      "kind": "bindPureRunAbilityToUnit",
      "parameters": {
        "unitAlias": "p1_0",
        "skillId": "amazon.multi_stab",
        "level": 1
      }
    },
    {
      "adapter": "Battle",
      "kind": "setUnitState",
      "parameters": {
        "unitAlias": "p1_0",
        "maxMana": 20,
        "mana": 20
      }
    },
    {
      "adapter": "UI",
      "kind": "openUI",
      "parameters": {
        "uiId": "Battle"
      }
    },
    {
      "adapter": "Battle",
      "kind": "clickBattleUnit",
      "parameters": {
        "unitAlias": "p1_0"
      }
    },
    {
      "adapter": "Battle",
      "kind": "setUnitFacing",
      "parameters": {
        "unitAlias": "p1_0",
        "facing": "East"
      }
    },
    {
      "adapter": "UI",
      "kind": "refreshBattleActions",
      "parameters": {}
    },
    {
      "adapter": "UI",
      "kind": "clickElement",
      "parameters": {
        "elementName": "AbilityCard_连续刺击_Lv1"
      }
    },
    {
      "adapter": "Battle",
      "kind": "clickBattleUnit",
      "parameters": {
        "unitAlias": "p2_0",
        "expectedOrderedCount": 1
      }
    },
    {
      "adapter": "Battle",
      "kind": "clickBattleUnit",
      "parameters": {
        "unitAlias": "p2_0",
        "expectedOrderedCount": 2
      }
    },
    {
      "adapter": "UI",
      "kind": "refreshBattleActions",
      "parameters": {}
    },
    {
      "adapter": "UI",
      "kind": "rightClickElement",
      "parameters": {
        "elementName": "OrderedSelectionPanel"
      }
    },
    {
      "adapter": "UI",
      "kind": "pressKey",
      "parameters": {
        "elementName": "OrderedSelectionPanel",
        "key": "Escape"
      }
    },
    {
      "adapter": "UI",
      "kind": "pressKey",
      "parameters": {
        "elementName": "OrderedSelectionPanel",
        "key": "Escape"
      }
    }
  ],
  "assertionPlans": [
    {
      "adapter": "UI",
      "kind": "targetMarkerOrderEquals",
      "target": "OrderedTargetMarkerRoot",
      "expected": [],
      "parameters": {}
    },
    {
      "adapter": "UI",
      "kind": "elementVisible",
      "target": "OrderedSelectionPanel",
      "expected": false,
      "parameters": {}
    }
  ],
  "timeoutMs": 15000,
  "probeRequests": [
    {
      "adapter": "UI",
      "kind": "targetMarkerOrderEquals",
      "target": "OrderedTargetMarkerRoot",
      "parameters": {}
    },
    {
      "adapter": "UI",
      "kind": "elementVisible",
      "target": "OrderedSelectionPanel",
      "parameters": {}
    }
  ]
}
