{
  "schemaVersion": 1,
  "scenarioName": "Battle.HealRestoresHealth",
  "requiredAdapters": [
    "Battle",
    "Skill"
  ],
  "setupActions": [
    {
      "adapter": "Battle",
      "kind": "bindBattleController",
      "parameters": {}
    },
    {
      "adapter": "Skill",
      "kind": "createSkillGraph",
      "parameters": {
        "alias": "meleeAttackGraph",
        "graphKind": "singleTargetDamage",
        "baseDamage": 5,
        "isRanged": false,
        "minRange": 1,
        "maxRange": 1
      }
    },
    {
      "adapter": "Skill",
      "kind": "createSkillGraph",
      "parameters": {
        "alias": "selfHealGraph",
        "graphKind": "selfHeal",
        "healAmount": 3
      }
    }
  ],
  "runtimeActions": [
    {
      "adapter": "Battle",
      "kind": "executeBattleSkillGraph",
      "parameters": {
        "graphAlias": "meleeAttackGraph",
        "casterAlias": "p2_0",
        "targetAlias": "p1_0"
      }
    },
    {
      "adapter": "Battle",
      "kind": "executeBattleSkillGraph",
      "parameters": {
        "graphAlias": "selfHealGraph",
        "casterAlias": "p1_0"
      }
    }
  ],
  "assertionPlans": [
    {
      "adapter": "Battle",
      "kind": "battleIsActive",
      "expected": true,
      "parameters": {}
    }
  ],
  "timeoutMs": 15000,
  "probeRequests": [
    {
      "adapter": "Battle",
      "kind": "battleIsActive",
      "parameters": {}
    }
  ]
}
