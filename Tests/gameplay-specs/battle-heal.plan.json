{
  "schemaVersion": 1,
  "scenarioName": "Battle.HealRestoresHealth",
  "requiredAdapters": [
    "Battle"
  ],
  "setupActions": [
    {
      "adapter": "Battle",
      "kind": "bindBattleController",
      "parameters": {}
    }
  ],
  "runtimeActions": [
    {
      "adapter": "Battle",
      "kind": "executeAbility",
      "parameters": {
        "commandType": "attack",
        "attackerAlias": "p2_0",
        "targetAlias": "p1_0",
        "damage": 5
      }
    },
    {
      "adapter": "Battle",
      "kind": "executeAbility",
      "parameters": {
        "commandType": "heal",
        "casterAlias": "p1_0",
        "targetAlias": "p1_0",
        "healAmount": 3
      }
    }
  ],
  "assertionPlans": [
    {
      "adapter": "Battle",
      "kind": "battleIsActive",
      "expected": true,
      "parameters": {}
    }
  ],
  "timeoutMs": 10000,
  "probeRequests": [
    {
      "adapter": "Battle",
      "kind": "battleIsActive",
      "parameters": {}
    }
  ]
}
