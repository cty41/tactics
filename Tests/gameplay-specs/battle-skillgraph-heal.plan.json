{
  "schemaVersion": 1,
  "scenarioName": "Battle.SkillGraphHeal",
  "requiredAdapters": [
    "Battle"
  ],
  "setupActions": [
    {
      "adapter": "Battle",
      "kind": "bindBattleController",
      "parameters": {}
    },
    {
      "adapter": "Skill",
      "kind": "createSkillGraph",
      "parameters": {
        "alias": "selfHealGraph",
        "graphKind": "selfHeal",
        "healAmount": 5
      }
    },
    {
      "adapter": "Battle",
      "kind": "setUnitState",
      "parameters": {
        "unitAlias": "p1_0",
        "health": 15,
        "maxHealth": 20
      }
    }
  ],
  "runtimeActions": [
    {
      "adapter": "Battle",
      "kind": "executeBattleSkillGraph",
      "parameters": {
        "graphAlias": "selfHealGraph",
        "casterAlias": "p1_0"
      }
    }
  ],
  "assertionPlans": [
    {
      "adapter": "Battle",
      "kind": "unitHealthEquals",
      "target": "p1_0",
      "parameters": {
        "expected": 20
      }
    }
  ],
  "timeoutMs": 15000,
  "probeRequests": [
    {
      "adapter": "Battle",
      "kind": "unitHealthEquals",
      "target": "p1_0",
      "parameters": {}
    }
  ]
}
