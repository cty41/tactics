{
  "schemaVersion": 1,
  "scenarioName": "Battle.FrozenBuffExpiry",
  "requiredAdapters": [
    "Battle"
  ],
  "setupActions": [
    {
      "adapter": "Battle",
      "kind": "bindBattleController",
      "parameters": {}
    },
    {
      "adapter": "Battle",
      "kind": "addBuff",
      "parameters": {
        "unitAlias": "p2_0",
        "buffName": "Frozen",
        "duration": 2
      }
    }
  ],
  "runtimeActions": [
    {
      "adapter": "Battle",
      "kind": "advanceTurn",
      "parameters": {}
    },
    {
      "adapter": "Battle",
      "kind": "advanceTurn",
      "parameters": {}
    }
  ],
  "assertionPlans": [
    {
      "adapter": "Battle",
      "kind": "unitBuffDurationEquals",
      "target": "p2_0",
      "expected": 0,
      "parameters": {
        "buffName": "Frozen"
      }
    },
    {
      "adapter": "Battle",
      "kind": "unitDoesNotHaveBuff",
      "target": "p2_0",
      "expected": "Frozen",
      "parameters": {}
    }
  ],
  "timeoutMs": 10000,
  "probeRequests": [
    {
      "adapter": "Battle",
      "kind": "unitHasBuff",
      "target": "p2_0",
      "parameters": {}
    }
  ]
}
