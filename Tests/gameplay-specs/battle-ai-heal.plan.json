{
  "schemaVersion": 1,
  "scenarioName": "Battle.AIHeal",
  "requiredAdapters": [
    "Battle",
    "Skill"
  ],
  "setupActions": [
    {
      "adapter": "Battle",
      "kind": "bindBattleController",
      "parameters": {}
    },
    {
      "adapter": "Skill",
      "kind": "createSkillGraph",
      "parameters": {
        "alias": "meleeAttackGraph",
        "graphKind": "singleTargetDamage",
        "baseDamage": 10,
        "isRanged": false,
        "minRange": 1,
        "maxRange": 1
      }
    },
    {
      "adapter": "Skill",
      "kind": "createSkillGraph",
      "parameters": {
        "alias": "selfHealGraph",
        "graphKind": "selfHeal",
        "healAmount": 5
      }
    },
    {
      "adapter": "Battle",
      "kind": "createAiBrain",
      "parameters": {
        "brainAssetAlias": "heal_brain",
        "brainType": "heal"
      }
    }
  ],
  "runtimeActions": [
    {
      "adapter": "Battle",
      "kind": "executeBattleSkillGraph",
      "parameters": {
        "graphAlias": "meleeAttackGraph",
        "casterAlias": "p2_0",
        "targetAlias": "p1_0"
      }
    },
    {
      "adapter": "Battle",
      "kind": "executeBattleSkillGraph",
      "parameters": {
        "graphAlias": "selfHealGraph",
        "casterAlias": "p1_0"
      }
    }
  ],
  "assertionPlans": [
    {
      "adapter": "Battle",
      "kind": "unitHealthEquals",
      "target": "p1_0",
      "parameters": {
        "expected": 15
      }
    },
    {
      "adapter": "Battle",
      "kind": "unitAliveEquals",
      "target": "p1_0",
      "expected": true,
      "parameters": {}
    }
  ],
  "timeoutMs": 15000,
  "probeRequests": [
    {
      "adapter": "Battle",
      "kind": "unitHealthEquals",
      "target": "p1_0",
      "parameters": {}
    }
  ]
}
