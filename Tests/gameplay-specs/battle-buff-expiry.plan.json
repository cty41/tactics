{
  "schemaVersion": 1,
  "scenarioName": "Battle.BuffExpiry",
  "requiredAdapters": [
    "Battle"
  ],
  "setupActions": [
    {
      "adapter": "Battle",
      "kind": "bindBattleController",
      "parameters": {}
    },
    {
      "adapter": "Battle",
      "kind": "addBuff",
      "parameters": {
        "unitAlias": "p2_0",
        "buffName": "Ignite",
        "duration": 1
      }
    }
  ],
  "runtimeActions": [
    {
      "adapter": "Battle",
      "kind": "advanceTurn",
      "parameters": {}
    }
  ],
  "assertionPlans": [
    {
      "adapter": "Battle",
      "kind": "unitHasBuff",
      "target": "p2_0",
      "expected": "Ignite",
      "parameters": {}
    }
  ],
  "timeoutMs": 10000,
  "probeRequests": [
    {
      "adapter": "Battle",
      "kind": "unitHasBuff",
      "target": "p2_0",
      "parameters": {}
    }
  ]
}
