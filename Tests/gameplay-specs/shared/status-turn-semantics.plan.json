{
  "schemaVersion": 1,
  "scenarioName": "SharedBattlePrimitives.StatusTurnSemantics",
  "contractIds": [
    "BUFF-REFRESH-STRATEGY-001",
    "BUFF-POISON-SOURCE-001"
  ],
  "requiredAdapters": [
    "Skill",
    "Battle"
  ],
  "setupActions": [
    {
      "adapter": "Skill",
      "kind": "createSkillTestWorld",
      "parameters": {}
    },
    {
      "adapter": "Skill",
      "kind": "createCell",
      "parameters": {
        "alias": "sourceCell",
        "x": 0,
        "y": 0
      }
    },
    {
      "adapter": "Skill",
      "kind": "createCell",
      "parameters": {
        "alias": "targetCell",
        "x": 1,
        "y": 0
      }
    },
    {
      "adapter": "Skill",
      "kind": "createCell",
      "parameters": {
        "alias": "stunCell",
        "x": 2,
        "y": 0
      }
    },
    {
      "adapter": "Skill",
      "kind": "createUnit",
      "parameters": {
        "alias": "source",
        "playerNumber": 0,
        "cellAlias": "sourceCell"
      }
    },
    {
      "adapter": "Skill",
      "kind": "createUnit",
      "parameters": {
        "alias": "target",
        "playerNumber": 1,
        "cellAlias": "targetCell",
        "maxHealth": 30,
        "health": 30
      }
    },
    {
      "adapter": "Skill",
      "kind": "createUnit",
      "parameters": {
        "alias": "stunTarget",
        "playerNumber": 1,
        "cellAlias": "stunCell"
      }
    }
  ],
  "runtimeActions": [
    {
      "adapter": "Battle",
      "kind": "addBuff",
      "parameters": {
        "unitAlias": "target",
        "buffName": "BurningA",
        "configAlias": "burning_a",
        "duration": 2,
        "effectType": "Burning"
      }
    },
    {
      "adapter": "Battle",
      "kind": "addBuff",
      "parameters": {
        "unitAlias": "target",
        "buffName": "BurningB",
        "configAlias": "burning_b",
        "duration": 1,
        "effectType": "Burning"
      }
    },
    {
      "adapter": "Battle",
      "kind": "addBuff",
      "parameters": {
        "unitAlias": "target",
        "buffName": "PoisonA",
        "configAlias": "poison_a",
        "duration": 99,
        "effectType": "Poison"
      }
    },
    {
      "adapter": "Battle",
      "kind": "addBuff",
      "parameters": {
        "unitAlias": "target",
        "buffName": "PoisonB",
        "configAlias": "poison_b",
        "duration": 1,
        "effectType": "Poison"
      }
    },
    {
      "adapter": "Battle",
      "kind": "addBuff",
      "parameters": {
        "unitAlias": "stunTarget",
        "buffName": "StunA",
        "configAlias": "stun_a",
        "duration": 5,
        "effectType": "Stun",
        "canAct": false
      }
    },
    {
      "adapter": "Battle",
      "kind": "addBuff",
      "parameters": {
        "unitAlias": "stunTarget",
        "buffName": "StunB",
        "configAlias": "stun_b",
        "duration": 9,
        "effectType": "Stun",
        "canAct": false
      }
    },
    {
      "adapter": "Battle",
      "kind": "tickUnitTurnStart",
      "parameters": {
        "unitAlias": "target"
      }
    },
    {
      "adapter": "Battle",
      "kind": "tickUnitTurnEnd",
      "parameters": {
        "unitAlias": "target"
      }
    },
    {
      "adapter": "Battle",
      "kind": "tickUnitTurnStart",
      "parameters": {
        "unitAlias": "stunTarget"
      }
    }
  ],
  "assertionPlans": [
    {
      "adapter": "Battle",
      "kind": "unitHealthEquals",
      "target": "target",
      "expected": 25,
      "parameters": {}
    },
    {
      "adapter": "Battle",
      "kind": "unitStatusStacksEquals",
      "target": "target",
      "expected": 2,
      "parameters": {
        "buffName": "BurningA"
      }
    },
    {
      "adapter": "Battle",
      "kind": "unitStatusStacksEquals",
      "target": "target",
      "expected": 1,
      "parameters": {
        "buffName": "PoisonA"
      }
    },
    {
      "adapter": "Battle",
      "kind": "unitStatusRemainingActionsEquals",
      "target": "target",
      "expected": 5,
      "parameters": {
        "buffName": "PoisonA"
      }
    },
    {
      "adapter": "Battle",
      "kind": "unitStatusRemainingActionsEquals",
      "target": "stunTarget",
      "expected": 1,
      "parameters": {
        "buffName": "StunA"
      }
    },
    {
      "adapter": "Battle",
      "kind": "unitCanAct",
      "target": "stunTarget",
      "expected": false,
      "parameters": {}
    }
  ],
  "timeoutMs": 10000,
  "probeRequests": [
    {
      "adapter": "Battle",
      "kind": "unitHealthEquals",
      "target": "target",
      "parameters": {}
    },
    {
      "adapter": "Battle",
      "kind": "unitStatusStacksEquals",
      "target": "target",
      "parameters": {
        "buffName": "BurningA"
      }
    },
    {
      "adapter": "Battle",
      "kind": "unitStatusStacksEquals",
      "target": "target",
      "parameters": {
        "buffName": "PoisonA"
      }
    },
    {
      "adapter": "Battle",
      "kind": "unitStatusRemainingActionsEquals",
      "target": "target",
      "parameters": {
        "buffName": "PoisonA"
      }
    },
    {
      "adapter": "Battle",
      "kind": "unitStatusRemainingActionsEquals",
      "target": "stunTarget",
      "parameters": {
        "buffName": "StunA"
      }
    },
    {
      "adapter": "Battle",
      "kind": "unitCanAct",
      "target": "stunTarget",
      "parameters": {}
    }
  ]
}
