{
  "schemaVersion": 1,
  "scenarioName": "SharedBattlePrimitives.SummonRegistryOrder",
  "requiredAdapters": [
    "Skill",
    "Battle"
  ],
  "setupActions": [
    {
      "adapter": "Skill",
      "kind": "createSkillTestWorld",
      "parameters": {}
    },
    {
      "adapter": "Skill",
      "kind": "createCell",
      "parameters": {
        "alias": "ownerCell",
        "x": 0,
        "y": 0
      }
    },
    {
      "adapter": "Skill",
      "kind": "createCell",
      "parameters": {
        "alias": "aCell",
        "x": 1,
        "y": 0
      }
    },
    {
      "adapter": "Skill",
      "kind": "createCell",
      "parameters": {
        "alias": "bCell",
        "x": 2,
        "y": 0
      }
    },
    {
      "adapter": "Skill",
      "kind": "createCell",
      "parameters": {
        "alias": "cCell",
        "x": 3,
        "y": 0
      }
    },
    {
      "adapter": "Skill",
      "kind": "createUnit",
      "parameters": {
        "alias": "owner",
        "playerNumber": 0,
        "cellAlias": "ownerCell"
      }
    },
    {
      "adapter": "Skill",
      "kind": "createUnit",
      "parameters": {
        "alias": "summonA",
        "playerNumber": 0,
        "cellAlias": "aCell"
      }
    },
    {
      "adapter": "Skill",
      "kind": "createUnit",
      "parameters": {
        "alias": "summonB",
        "playerNumber": 0,
        "cellAlias": "bCell"
      }
    },
    {
      "adapter": "Skill",
      "kind": "createUnit",
      "parameters": {
        "alias": "summonC",
        "playerNumber": 0,
        "cellAlias": "cCell"
      }
    }
  ],
  "runtimeActions": [
    {
      "adapter": "Battle",
      "kind": "registerSummon",
      "parameters": {
        "ownerAlias": "owner",
        "summonAlias": "summonA",
        "category": "FireDemon",
        "maximumActive": 2
      }
    },
    {
      "adapter": "Battle",
      "kind": "registerSummon",
      "parameters": {
        "ownerAlias": "owner",
        "summonAlias": "summonB",
        "category": "FireDemon",
        "maximumActive": 2
      }
    },
    {
      "adapter": "Battle",
      "kind": "registerSummon",
      "parameters": {
        "ownerAlias": "owner",
        "summonAlias": "summonC",
        "category": "FireDemon",
        "maximumActive": 2
      }
    }
  ],
  "assertionPlans": [
    {
      "adapter": "Battle",
      "kind": "summonOrderEquals",
      "target": "owner",
      "expected": [
        "summonB",
        "summonC"
      ],
      "parameters": {
        "category": "FireDemon"
      }
    },
    {
      "adapter": "Battle",
      "kind": "summonCategoryEquals",
      "target": "summonC",
      "expected": "FireDemon",
      "parameters": {}
    },
    {
      "adapter": "Battle",
      "kind": "unitAliveEquals",
      "target": "summonA",
      "expected": false,
      "parameters": {}
    }
  ],
  "timeoutMs": 10000,
  "probeRequests": [
    {
      "adapter": "Battle",
      "kind": "summonOrderEquals",
      "target": "owner",
      "parameters": {
        "category": "FireDemon"
      }
    },
    {
      "adapter": "Battle",
      "kind": "summonCategoryEquals",
      "target": "summonC",
      "parameters": {}
    },
    {
      "adapter": "Battle",
      "kind": "unitAliveEquals",
      "target": "summonA",
      "parameters": {}
    }
  ]
}
