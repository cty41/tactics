{
  "schemaVersion": 1,
  "scenarioName": "SharedBattlePrimitives.FacingAndInitiative",
  "requiredAdapters": [
    "Skill",
    "Battle"
  ],
  "setupActions": [
    {
      "adapter": "Skill",
      "kind": "createSkillTestWorld",
      "parameters": {}
    },
    {
      "adapter": "Skill",
      "kind": "createCell",
      "parameters": {
        "alias": "actorCell",
        "x": 0,
        "y": 0
      }
    },
    {
      "adapter": "Skill",
      "kind": "createCell",
      "parameters": {
        "alias": "northCell",
        "x": 0,
        "y": 1
      }
    },
    {
      "adapter": "Skill",
      "kind": "createCell",
      "parameters": {
        "alias": "targetCell",
        "x": 2,
        "y": 0
      }
    },
    {
      "adapter": "Skill",
      "kind": "createCell",
      "parameters": {
        "alias": "thirdCell",
        "x": 3,
        "y": 0
      }
    },
    {
      "adapter": "Skill",
      "kind": "createUnit",
      "parameters": {
        "alias": "actor",
        "playerNumber": 0,
        "cellAlias": "actorCell",
        "speed": 8
      }
    },
    {
      "adapter": "Skill",
      "kind": "createUnit",
      "parameters": {
        "alias": "target",
        "playerNumber": 1,
        "cellAlias": "targetCell",
        "speed": 6
      }
    },
    {
      "adapter": "Skill",
      "kind": "createUnit",
      "parameters": {
        "alias": "third",
        "playerNumber": 1,
        "cellAlias": "thirdCell",
        "speed": 5
      }
    }
  ],
  "runtimeActions": [
    {
      "adapter": "Battle",
      "kind": "setUnitFacing",
      "parameters": {
        "unitAlias": "actor",
        "facing": "East"
      }
    },
    {
      "adapter": "Battle",
      "kind": "initializeInitiativeOrder",
      "parameters": {
        "unitAliases": [
          "actor",
          "target",
          "third"
        ]
      }
    },
    {
      "adapter": "Battle",
      "kind": "advanceInitiative",
      "parameters": {}
    },
    {
      "adapter": "Battle",
      "kind": "addBuff",
      "parameters": {
        "unitAlias": "target",
        "buffName": "Slow",
        "configAlias": "shared_slow",
        "duration": 2,
        "effectType": "Slow",
        "speedModifier": -2,
        "refreshStrategy": "RefreshDuration"
      }
    },
    {
      "adapter": "Battle",
      "kind": "moveUnit",
      "parameters": {
        "unitAlias": "actor",
        "cellAlias": "northCell"
      }
    }
  ],
  "assertionPlans": [
    {
      "adapter": "Battle",
      "kind": "unitFacingEquals",
      "target": "actor",
      "expected": "North",
      "parameters": {}
    },
    {
      "adapter": "Battle",
      "kind": "currentRoundOrderEquals",
      "expected": [
        "actor",
        "third",
        "target"
      ],
      "parameters": {}
    },
    {
      "adapter": "Battle",
      "kind": "unitStatusRemainingActionsEquals",
      "target": "target",
      "expected": 2,
      "parameters": {
        "buffName": "Slow"
      }
    }
  ],
  "timeoutMs": 10000,
  "probeRequests": [
    {
      "adapter": "Battle",
      "kind": "unitFacingEquals",
      "target": "actor",
      "parameters": {}
    },
    {
      "adapter": "Battle",
      "kind": "currentRoundOrderEquals",
      "parameters": {}
    },
    {
      "adapter": "Battle",
      "kind": "unitStatusRemainingActionsEquals",
      "target": "target",
      "parameters": {
        "buffName": "Slow"
      }
    }
  ]
}
