{
  "schemaVersion": 1,
  "scenarioName": "SkillGraph.AreaDamageHitsAllTargetsInRadius",
  "requiredAdapters": [
    "Skill"
  ],
  "setupActions": [
    {
      "adapter": "Skill",
      "kind": "createSkillTestWorld",
      "parameters": {}
    },
    {
      "adapter": "Skill",
      "kind": "createSkillGraph",
      "parameters": {
        "alias": "areaGraph",
        "graphKind": "areaDamage",
        "baseDamage": 3,
        "radius": 1,
        "maxRange": 4
      }
    },
    {
      "adapter": "Skill",
      "kind": "createCell",
      "parameters": {
        "alias": "casterCell",
        "x": 0,
        "y": 0
      }
    },
    {
      "adapter": "Skill",
      "kind": "createCell",
      "parameters": {
        "alias": "targetPointCell",
        "x": 1,
        "y": 1
      }
    },
    {
      "adapter": "Skill",
      "kind": "createCell",
      "parameters": {
        "alias": "targetCellA",
        "x": 1,
        "y": 0
      }
    },
    {
      "adapter": "Skill",
      "kind": "createCell",
      "parameters": {
        "alias": "targetCellB",
        "x": 0,
        "y": 1
      }
    },
    {
      "adapter": "Skill",
      "kind": "createCell",
      "parameters": {
        "alias": "safeCell",
        "x": 4,
        "y": 4
      }
    },
    {
      "adapter": "Skill",
      "kind": "createUnit",
      "parameters": {
        "alias": "caster",
        "playerNumber": 0,
        "health": 10,
        "maxHealth": 10,
        "cellAlias": "casterCell"
      }
    },
    {
      "adapter": "Skill",
      "kind": "createUnit",
      "parameters": {
        "alias": "targetA",
        "playerNumber": 1,
        "health": 10,
        "maxHealth": 10,
        "defenceFactor": 0,
        "cellAlias": "targetCellA"
      }
    },
    {
      "adapter": "Skill",
      "kind": "createUnit",
      "parameters": {
        "alias": "targetB",
        "playerNumber": 1,
        "health": 10,
        "maxHealth": 10,
        "defenceFactor": 0,
        "cellAlias": "targetCellB"
      }
    },
    {
      "adapter": "Skill",
      "kind": "createUnit",
      "parameters": {
        "alias": "safeTarget",
        "playerNumber": 1,
        "health": 10,
        "maxHealth": 10,
        "defenceFactor": 0,
        "cellAlias": "safeCell"
      }
    },
    {
      "adapter": "Skill",
      "kind": "setTurnContext",
      "parameters": {
        "currentPlayerNumber": 0,
        "playableUnitAliases": [
          "caster"
        ]
      }
    }
  ],
  "runtimeActions": [
    {
      "adapter": "Skill",
      "kind": "executeSkillGraph",
      "parameters": {
        "graphAlias": "areaGraph",
        "casterAlias": "caster",
        "targetPointAlias": "targetPointCell"
      }
    }
  ],
  "assertionPlans": [
    {
      "adapter": "Skill",
      "kind": "executionStateEquals",
      "expected": "Completed",
      "parameters": {}
    },
    {
      "adapter": "Skill",
      "kind": "unitCountInArea",
      "expected": 3,
      "parameters": {
        "centerAlias": "targetPointCell",
        "radius": 1
      }
    },
    {
      "adapter": "Skill",
      "kind": "unitHealthEquals",
      "target": "targetA",
      "expected": 7,
      "parameters": {}
    },
    {
      "adapter": "Skill",
      "kind": "unitHealthEquals",
      "target": "targetB",
      "expected": 7,
      "parameters": {}
    },
    {
      "adapter": "Skill",
      "kind": "unitHealthEquals",
      "target": "safeTarget",
      "expected": 10,
      "parameters": {}
    }
  ],
  "timeoutMs": 10000,
  "probeRequests": [
    {
      "adapter": "Skill",
      "kind": "executionStateEquals",
      "parameters": {}
    },
    {
      "adapter": "Skill",
      "kind": "unitCountInArea",
      "parameters": {
        "centerAlias": "targetPointCell",
        "radius": 1
      }
    },
    {
      "adapter": "Skill",
      "kind": "unitHealthEquals",
      "target": "targetA",
      "parameters": {}
    },
    {
      "adapter": "Skill",
      "kind": "unitHealthEquals",
      "target": "targetB",
      "parameters": {}
    },
    {
      "adapter": "Skill",
      "kind": "unitHealthEquals",
      "target": "safeTarget",
      "parameters": {}
    }
  ]
}
