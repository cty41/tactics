    {
      "adapter": "Map",
      "kind": "completeNode",
      "parameters": {
        "nodeId": "layer_03_battle"
      }
    },
    {
      "adapter": "Map",
      "kind": "completeNode",
      "parameters": {
        "nodeId": "layer_04_rest"
      }
    },
    {
      "adapter": "Map",
