{
  "schemaVersion": 1,
  "scenarioName": "SkillGraph.ProjectileHitsTarget",
  "requiredAdapters": [
    "Skill"
  ],
  "setupActions": [
    {
      "adapter": "Skill",
      "kind": "createSkillTestWorld",
      "parameters": {}
    },
    {
      "adapter": "Skill",
      "kind": "createSkillGraph",
      "parameters": {
        "alias": "projectileGraph",
        "graphKind": "projectile",
        "baseDamage": 5,
        "travelTime": 0.05
      }
    },
    {
      "adapter": "Skill",
      "kind": "createCell",
      "parameters": {
        "alias": "casterCell",
        "x": 0,
        "y": 0
      }
    },
    {
      "adapter": "Skill",
      "kind": "createCell",
      "parameters": {
        "alias": "targetCell",
        "x": 2,
        "y": 0
      }
    },
    {
      "adapter": "Skill",
      "kind": "createUnit",
      "parameters": {
        "alias": "caster",
        "playerNumber": 0,
        "health": 10,
        "maxHealth": 10,
        "cellAlias": "casterCell"
      }
    },
    {
      "adapter": "Skill",
      "kind": "createUnit",
      "parameters": {
        "alias": "target",
        "playerNumber": 1,
        "health": 10,
        "maxHealth": 10,
        "defenceFactor": 0,
        "cellAlias": "targetCell"
      }
    },
    {
      "adapter": "Skill",
      "kind": "setTurnContext",
      "parameters": {
        "currentPlayerNumber": 0,
        "playableUnitAliases": [
          "caster"
        ]
      }
    }
  ],
  "runtimeActions": [
    {
      "adapter": "Skill",
      "kind": "executeSkillGraph",
      "parameters": {
        "graphAlias": "projectileGraph",
        "casterAlias": "caster",
        "primaryTargetAlias": "target"
      }
    }
  ],
  "assertionPlans": [
    {
      "adapter": "Skill",
      "kind": "executionStateEquals",
      "expected": "Completed",
      "parameters": {}
    },
    {
      "adapter": "Skill",
      "kind": "unitHealthEquals",
      "target": "target",
      "expected": 5,
      "parameters": {}
    }
  ],
  "timeoutMs": 10000,
  "probeRequests": [
    {
      "adapter": "Skill",
      "kind": "executionStateEquals",
      "parameters": {}
    },
    {
      "adapter": "Skill",
      "kind": "unitHealthEquals",
      "target": "target",
      "parameters": {}
    }
  ]
}
