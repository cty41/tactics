{
  "schemaVersion": 1,
  "scenarioName": "SkillGraph.InvalidGraphWithoutTerminalIsRejected",
  "requiredAdapters": [
    "Skill"
  ],
  "setupActions": [
    {
      "kind": "createSkillTestWorld",
      "parameters": {},
      "adapter": "Skill"
    },
    {
      "kind": "createSkillGraph",
      "parameters": {
        "alias": "graph",
        "graphKind": "invalidSelfHeal",
        "healAmount": 5
      },
      "adapter": "Skill"
    },
    {
      "kind": "createUnit",
      "parameters": {
        "alias": "caster",
        "playerNumber": 0,
        "health": 10,
        "maxHealth": 10
      },
      "adapter": "Skill"
    },
    {
      "kind": "setTurnContext",
      "parameters": {
        "currentPlayerNumber": 0,
        "playableUnitAliases": [
          "caster"
        ]
      },
      "adapter": "Skill"
    }
  ],
  "runtimeActions": [
    {
      "kind": "executeSkillGraph",
      "parameters": {
        "graphAlias": "graph",
        "casterAlias": "caster"
      },
      "adapter": "Skill"
    }
  ],
  "assertionPlans": [
    {
      "kind": "executionStateEquals",
      "expected": "Aborted",
      "parameters": {},
      "adapter": "Skill"
    },
    {
      "kind": "validationErrorCodeIncludes",
      "expected": "NoTerminalNode",
      "parameters": {},
      "adapter": "Skill"
    }
  ],
  "timeoutMs": 10000,
  "probeRequests": [
    {
      "adapter": "Skill",
      "kind": "executionStateEquals",
      "parameters": {}
    },
    {
      "adapter": "Skill",
      "kind": "validationErrorCodeIncludes",
      "parameters": {}
    }
  ]
}
