{
  "schemaVersion": 1,
  "scenarioName": "Necromancer.SummonRequiresCorpse",
  "requiredAdapters": [
    "Skill"
  ],
  "setupActions": [
    {
      "adapter": "Skill",
      "kind": "createSkillTestWorld",
      "parameters": {}
    },
    {
      "adapter": "Skill",
      "kind": "createSkillGraph",
      "parameters": {
        "alias": "summonGraph",
        "graphKind": "singleTargetDamage",
        "baseDamage": 0,
        "canCrit": false,
        "isRanged": false,
        "minRange": 1,
        "maxRange": 3
      }
    },
    {
      "adapter": "Skill",
      "kind": "createCell",
      "parameters": {
        "alias": "casterCell",
        "x": 0,
        "y": 0
      }
    },
    {
      "adapter": "Skill",
      "kind": "createCell",
      "parameters": {
        "alias": "emptyCell",
        "x": 2,
        "y": 0
      }
    },
    {
      "adapter": "Skill",
      "kind": "createUnit",
      "parameters": {
        "alias": "caster",
        "playerNumber": 0,
        "health": 10,
        "maxHealth": 10,
        "cellAlias": "casterCell"
      }
    },
    {
      "adapter": "Skill",
      "kind": "createUnit",
      "parameters": {
        "alias": "emptyTarget",
        "playerNumber": 1,
        "health": 10,
        "maxHealth": 10,
        "cellAlias": "emptyCell"
      }
    },
    {
      "adapter": "Skill",
      "kind": "setTurnContext",
      "parameters": {
        "currentPlayerNumber": 0,
        "playableUnitAliases": [
          "caster"
        ]
      }
    }
  ],
  "runtimeActions": [
    {
      "adapter": "Skill",
      "kind": "executeSkillGraph",
      "parameters": {
        "graphAlias": "summonGraph",
        "casterAlias": "caster",
        "primaryTargetAlias": "emptyTarget"
      }
    }
  ],
  "assertionPlans": [
    {
      "adapter": "Skill",
      "kind": "unitHealthEquals",
      "target": "emptyTarget",
      "expected": 10,
      "parameters": {}
    }
  ],
  "timeoutMs": 10000,
  "probeRequests": [
    {
      "adapter": "Skill",
      "kind": "unitHealthEquals",
      "target": "emptyTarget",
      "parameters": {}
    }
  ]
}
