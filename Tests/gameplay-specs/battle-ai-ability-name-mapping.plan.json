{
  "schemaVersion": 1,
  "scenarioName": "Battle.AIAbilityNameMapping",
  "requiredAdapters": [
    "Battle"
  ],
  "setupActions": [
    {
      "adapter": "Battle",
      "kind": "bindBattleController",
      "parameters": {}
    },
    {
      "adapter": "Battle",
      "kind": "createAiBrain",
      "parameters": {
        "brainAssetAlias": "attack_brain",
        "brainType": "attack"
      }
    }
  ],
  "runtimeActions": [
    {
      "adapter": "Battle",
      "kind": "executeAI",
      "parameters": {
        "unitAlias": "p1_0",
        "brainAssetAlias": "attack_brain",
        "targetAlias": "p2_0"
      }
    }
  ],
  "assertionPlans": [
    {
      "adapter": "Battle",
      "kind": "aiSelectedIntentTypeEquals",
      "expected": "BasicAttack",
      "parameters": {}
    },
    {
      "adapter": "Battle",
      "kind": "aiWasNoOpEquals",
      "expected": false,
      "parameters": {}
    },
    {
      "adapter": "Battle",
      "kind": "decisionLogContains",
      "expected": "BasicAttack",
      "parameters": {}
    }
  ],
  "timeoutMs": 15000,
  "probeRequests": []
}
