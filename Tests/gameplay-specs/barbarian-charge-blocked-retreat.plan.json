{
  "schemaVersion": 1,
  "scenarioName": "SkillGraph.ChargeStrikeStopsBeforeBlockedRetreatAndDamagesBothUnits",
  "requiredAdapters": [
    "Skill"
  ],
  "setupActions": [
    {
      "adapter": "Skill",
      "kind": "createSkillTestWorld",
      "parameters": {}
    },
    {
      "adapter": "Skill",
      "kind": "createSkillGraph",
      "parameters": {
        "alias": "chargeGraph",
        "graphKind": "charge",
        "collisionDamage": 1,
        "maxRange": 3
      }
    },
    {
      "adapter": "Skill",
      "kind": "createCell",
      "parameters": {
        "alias": "casterCell",
        "x": 0,
        "y": 0
      }
    },
    {
      "adapter": "Skill",
      "kind": "createCell",
      "parameters": {
        "alias": "pathCell",
        "x": 1,
        "y": 0
      }
    },
    {
      "adapter": "Skill",
      "kind": "createCell",
      "parameters": {
        "alias": "targetCell",
        "x": 2,
        "y": 0
      }
    },
    {
      "adapter": "Skill",
      "kind": "createCell",
      "parameters": {
        "alias": "blockerCell",
        "x": 3,
        "y": 0
      }
    },
    {
      "adapter": "Skill",
      "kind": "createUnit",
      "parameters": {
        "alias": "caster",
        "playerNumber": 0,
        "health": 10,
        "maxHealth": 10,
        "cellAlias": "casterCell"
      }
    },
    {
      "adapter": "Skill",
      "kind": "createUnit",
      "parameters": {
        "alias": "target",
        "playerNumber": 1,
        "health": 10,
        "maxHealth": 10,
        "cellAlias": "targetCell"
      }
    },
    {
      "adapter": "Skill",
      "kind": "createUnit",
      "parameters": {
        "alias": "blocker",
        "playerNumber": 1,
        "health": 10,
        "maxHealth": 10,
        "cellAlias": "blockerCell"
      }
    },
    {
      "adapter": "Skill",
      "kind": "setTurnContext",
      "parameters": {
        "currentPlayerNumber": 0,
        "playableUnitAliases": [
          "caster"
        ]
      }
    }
  ],
  "runtimeActions": [
    {
      "adapter": "Skill",
      "kind": "executeSkillGraph",
      "parameters": {
        "graphAlias": "chargeGraph",
        "casterAlias": "caster",
        "primaryTargetAlias": "target"
      }
    }
  ],
  "assertionPlans": [
    {
      "adapter": "Skill",
      "kind": "executionStateEquals",
      "expected": "Completed",
      "parameters": {}
    },
    {
      "adapter": "Skill",
      "kind": "unitCellEquals",
      "target": "caster",
      "expected": {
        "x": 1,
        "y": 0
      },
      "parameters": {}
    },
    {
      "adapter": "Skill",
      "kind": "unitCellEquals",
      "target": "target",
      "expected": {
        "x": 2,
        "y": 0
      },
      "parameters": {}
    },
    {
      "adapter": "Skill",
      "kind": "unitHealthEquals",
      "target": "target",
      "expected": 9,
      "parameters": {}
    },
    {
      "adapter": "Skill",
      "kind": "unitHealthEquals",
      "target": "caster",
      "expected": 9,
      "parameters": {}
    },
    {
      "adapter": "Skill",
      "kind": "unitHealthEquals",
      "target": "blocker",
      "expected": 10,
      "parameters": {}
    }
  ],
  "timeoutMs": 10000,
  "probeRequests": [
    {
      "adapter": "Skill",
      "kind": "executionStateEquals",
      "parameters": {}
    },
    {
      "adapter": "Skill",
      "kind": "unitCellEquals",
      "target": "caster",
      "parameters": {}
    },
    {
      "adapter": "Skill",
      "kind": "unitCellEquals",
      "target": "target",
      "parameters": {}
    },
    {
      "adapter": "Skill",
      "kind": "unitHealthEquals",
      "target": "target",
      "parameters": {}
    },
    {
      "adapter": "Skill",
      "kind": "unitHealthEquals",
      "target": "target",
      "parameters": {}
    },
    {
      "adapter": "Skill",
      "kind": "unitHealthEquals",
      "target": "caster",
      "parameters": {}
    },
    {
      "adapter": "Skill",
      "kind": "unitHealthEquals",
      "target": "blocker",
      "parameters": {}
    }
  ]
}
