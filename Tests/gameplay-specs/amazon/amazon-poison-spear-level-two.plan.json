{
  "schemaVersion": 1,
  "scenarioName": "AmazonSkillLevels.PoisonSpearLevelTwoDropsUniqueSpearAndPoisonsCross",
  "requiredAdapters": [
    "Skill",
    "Battle"
  ],
  "setupActions": [
    {
      "adapter": "Battle",
      "kind": "useRealAssets",
      "parameters": {}
    },
    {
      "adapter": "Skill",
      "kind": "createSkillTestWorld",
      "parameters": {}
    },
    {
      "adapter": "Skill",
      "kind": "loadSkillGraphAsset",
      "parameters": {
        "alias": "poisonSpearLevelTwo",
        "assetPath": "Assets/Tactics/Battle/Abilities/SkillGraphs/PoisonSpear_Lv2_Graph.asset"
      }
    },
    {
      "adapter": "Skill",
      "kind": "createCell",
      "parameters": {
        "alias": "casterCell",
        "x": 0,
        "y": 1
      }
    },
    {
      "adapter": "Skill",
      "kind": "createCell",
      "parameters": {
        "alias": "targetCell",
        "x": 3,
        "y": 1
      }
    },
    {
      "adapter": "Skill",
      "kind": "createCell",
      "parameters": {
        "alias": "crossCell",
        "x": 3,
        "y": 2
      }
    },
    {
      "adapter": "Skill",
      "kind": "createCell",
      "parameters": {
        "alias": "diagonalCell",
        "x": 4,
        "y": 2
      }
    },
    {
      "adapter": "Skill",
      "kind": "createCell",
      "parameters": {
        "alias": "spearDropCell",
        "x": 4,
        "y": 1
      }
    },
    {
      "adapter": "Skill",
      "kind": "createCell",
      "parameters": {
        "alias": "connector1",
        "x": 1,
        "y": 1
      }
    },
    {
      "adapter": "Skill",
      "kind": "createCell",
      "parameters": {
        "alias": "connector2",
        "x": 2,
        "y": 1
      }
    },
    {
      "adapter": "Skill",
      "kind": "createUnit",
      "parameters": {
        "alias": "amazon",
        "playerNumber": 0,
        "cellAlias": "casterCell",
        "health": 40,
        "maxHealth": 40,
        "mana": 20,
        "maxMana": 20,
        "luck": -100
      }
    },
    {
      "adapter": "Skill",
      "kind": "createUnit",
      "parameters": {
        "alias": "target",
        "playerNumber": 1,
        "cellAlias": "targetCell",
        "health": 40,
        "maxHealth": 40,
        "defenceFactor": 0,
        "luck": -100
      }
    },
    {
      "adapter": "Skill",
      "kind": "createUnit",
      "parameters": {
        "alias": "cross",
        "playerNumber": 1,
        "cellAlias": "crossCell",
        "health": 40,
        "maxHealth": 40,
        "defenceFactor": 0,
        "luck": -100
      }
    },
    {
      "adapter": "Skill",
      "kind": "createUnit",
      "parameters": {
        "alias": "diagonal",
        "playerNumber": 1,
        "cellAlias": "diagonalCell",
        "health": 40,
        "maxHealth": 40,
        "defenceFactor": 0,
        "luck": -100
      }
    },
    {
      "adapter": "Skill",
      "kind": "setTurnContext",
      "parameters": {
        "currentPlayerNumber": 0,
        "playableUnitAliases": [
          "amazon"
        ]
      }
    }
  ],
  "runtimeActions": [
    {
      "adapter": "Skill",
      "kind": "executeSkillGraph",
      "parameters": {
        "graphAlias": "poisonSpearLevelTwo",
        "casterAlias": "amazon",
        "primaryTargetAlias": "target",
        "targetPointAlias": "targetCell"
      }
    }
  ],
  "assertionPlans": [
    {
      "adapter": "Skill",
      "kind": "executionStateEquals",
      "expected": "Completed",
      "parameters": {}
    },
    {
      "adapter": "Skill",
      "kind": "unitHealthEquals",
      "target": "target",
      "expected": 30,
      "parameters": {}
    },
    {
      "adapter": "Skill",
      "kind": "unitHasBuff",
      "target": "target",
      "expected": "Poison",
      "parameters": {}
    },
    {
      "adapter": "Skill",
      "kind": "unitHasBuff",
      "target": "cross",
      "expected": "Poison",
      "parameters": {}
    },
    {
      "adapter": "Skill",
      "kind": "unitBuffCountEquals",
      "target": "diagonal",
      "expected": 0,
      "parameters": {
        "buffName": "Poison"
      }
    },
    {
      "adapter": "Battle",
      "kind": "spearHolderEquals",
      "expected": "none",
      "parameters": {}
    },
    {
      "adapter": "Battle",
      "kind": "spearCellEquals",
      "expected": "spearDropCell",
      "parameters": {}
    }
  ],
  "timeoutMs": 10000,
  "probeRequests": [
    {
      "adapter": "Skill",
      "kind": "executionStateEquals",
      "parameters": {}
    },
    {
      "adapter": "Skill",
      "kind": "unitHealthEquals",
      "target": "target",
      "parameters": {}
    },
    {
      "adapter": "Skill",
      "kind": "unitHasBuff",
      "target": "target",
      "parameters": {}
    },
    {
      "adapter": "Skill",
      "kind": "unitHasBuff",
      "target": "cross",
      "parameters": {}
    },
    {
      "adapter": "Skill",
      "kind": "unitBuffCountEquals",
      "target": "diagonal",
      "parameters": {
        "buffName": "Poison"
      }
    },
    {
      "adapter": "Battle",
      "kind": "spearHolderEquals",
      "parameters": {}
    },
    {
      "adapter": "Battle",
      "kind": "spearCellEquals",
      "parameters": {}
    }
  ]
}
