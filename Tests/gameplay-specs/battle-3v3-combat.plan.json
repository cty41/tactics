{
  "schemaVersion": 1,
  "scenarioName": "Battle.3v3Combat",
  "requiredAdapters": [
    "Battle"
  ],
  "setupActions": [
    {
      "adapter": "Battle",
      "kind": "bindBattleController",
      "parameters": {}
    }
  ],
  "runtimeActions": [
    {
      "adapter": "Battle",
      "kind": "executeAbility",
      "parameters": {
        "commandType": "attack",
        "attackerAlias": "p1_0",
        "targetAlias": "p2_0",
        "damage": 999
      }
    }
  ],
  "assertionPlans": [
    {
      "adapter": "Battle",
      "kind": "unitAliveEquals",
      "target": "p2_0",
      "expected": false,
      "parameters": {}
    },
    {
      "adapter": "Battle",
      "kind": "battleResultEquals",
      "parameters": {
        "winnerPlayerNumber": 1
      }
    }
  ],
  "timeoutMs": 15000,
  "probeRequests": [
    {
      "adapter": "Battle",
      "kind": "unitAliveEquals",
      "target": "p2_0",
      "parameters": {}
    }
  ]
}
