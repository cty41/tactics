{
  "schemaVersion": 1,
  "scenarioName": "Battle.3v3Combat",
  "requiredAdapters": [
    "Battle",
    "Skill"
  ],
  "setupActions": [
    {
      "adapter": "Battle",
      "kind": "bindBattleController",
      "parameters": {}
    },
    {
      "adapter": "Skill",
      "kind": "createSkillGraph",
      "parameters": {
        "alias": "lethalAttackGraph",
        "graphKind": "singleTargetDamage",
        "baseDamage": 999,
        "isRanged": false,
        "minRange": 1,
        "maxRange": 1
      }
    }
  ],
  "runtimeActions": [
    {
      "adapter": "Battle",
      "kind": "executeBattleSkillGraph",
      "parameters": {
        "graphAlias": "lethalAttackGraph",
        "casterAlias": "p1_0",
        "targetAlias": "p2_0"
      }
    }
  ],
  "assertionPlans": [
    {
      "adapter": "Battle",
      "kind": "unitAliveEquals",
      "target": "p2_0",
      "expected": false,
      "parameters": {}
    },
    {
      "adapter": "Battle",
      "kind": "battleResultEquals",
      "parameters": {
        "winnerPlayerNumber": 1
      }
    }
  ],
  "timeoutMs": 15000,
  "probeRequests": [
    {
      "adapter": "Battle",
      "kind": "unitAliveEquals",
      "target": "p2_0",
      "parameters": {}
    }
  ]
}
