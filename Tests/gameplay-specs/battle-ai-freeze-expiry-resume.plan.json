{
  "schemaVersion": 1,
  "scenarioName": "Battle.AIFreezeExpiryResume",
  "requiredAdapters": [
    "Battle"
  ],
  "setupActions": [
    {
      "adapter": "Battle",
      "kind": "bindBattleController",
      "parameters": {}
    },
    {
      "adapter": "Battle",
      "kind": "createAiBrain",
      "parameters": {
        "brainAssetAlias": "attack_brain",
        "brainType": "attack"
      }
    },
    {
      "adapter": "Battle",
      "kind": "addBuff",
      "parameters": {
        "unitAlias": "p1_0",
        "buffName": "Frozen",
        "duration": 1
      }
    }
  ],
  "runtimeActions": [
    {
      "adapter": "Battle",
      "kind": "advanceTurn",
      "parameters": {}
    },
    {
      "adapter": "Battle",
      "kind": "executeAI",
      "parameters": {
        "unitAlias": "p1_0",
        "brainAssetAlias": "attack_brain",
        "targetAlias": "p2_0"
      }
    }
  ],
  "assertionPlans": [
    {
      "adapter": "Battle",
      "kind": "unitCanAct",
      "target": "p1_0",
      "expected": true,
      "parameters": {}
    },
    {
      "adapter": "Battle",
      "kind": "aiWasNoOpEquals",
      "expected": false,
      "parameters": {}
    },
    {
      "adapter": "Battle",
      "kind": "decisionLogContains",
      "expected": "Selected:",
      "parameters": {}
    }
  ],
  "timeoutMs": 15000,
  "probeRequests": [
    {
      "adapter": "Battle",
      "kind": "unitHealthEquals",
      "target": "p2_0",
      "parameters": {}
    }
  ]
}
