{
  "schemaVersion": 1,
  "scenarioName": "Battle.MutualCombat",
  "requiredAdapters": [
    "Battle"
  ],
  "setupActions": [
    {
      "adapter": "Battle",
      "kind": "bindBattleController",
      "parameters": {}
    },
    {
      "adapter": "Battle",
      "kind": "createAiBrain",
      "parameters": {
        "brainAssetAlias": "attack_brain",
        "brainType": "attack"
      }
    }
  ],
  "runtimeActions": [
    {
      "adapter": "Battle",
      "kind": "executeAbility",
      "parameters": {
        "commandType": "attack",
        "attackerAlias": "p1_0",
        "targetAlias": "p2_0",
        "damage": 5
      }
    },
    {
      "adapter": "Battle",
      "kind": "executeAbility",
      "parameters": {
        "commandType": "attack",
        "attackerAlias": "p2_0",
        "targetAlias": "p1_0",
        "damage": 5
      }
    },
    {
      "adapter": "Battle",
      "kind": "executeAbility",
      "parameters": {
        "commandType": "attack",
        "attackerAlias": "p1_0",
        "targetAlias": "p2_0",
        "damage": 5
      }
    }
  ],
  "assertionPlans": [
    {
      "adapter": "Battle",
      "kind": "unitHealthEquals",
      "target": "p1_0",
      "parameters": {
        "expected": 15
      }
    },
    {
      "adapter": "Battle",
      "kind": "unitHealthEquals",
      "target": "p2_0",
      "parameters": {
        "expected": 10
      }
    },
    {
      "adapter": "Battle",
      "kind": "unitAliveEquals",
      "target": "p1_0",
      "expected": true,
      "parameters": {}
    },
    {
      "adapter": "Battle",
      "kind": "unitAliveEquals",
      "target": "p2_0",
      "expected": true,
      "parameters": {}
    }
  ],
  "timeoutMs": 15000,
  "probeRequests": [
    {
      "adapter": "Battle",
      "kind": "unitHealthEquals",
      "target": "p1_0",
      "parameters": {}
    },
    {
      "adapter": "Battle",
      "kind": "unitHealthEquals",
      "target": "p2_0",
      "parameters": {}
    }
  ]
}
