{
  "schemaVersion": 1,
  "scenarioName": "Battle.AIFireball",
  "requiredAdapters": [
    "Battle"
  ],
  "setupActions": [
    {
      "adapter": "Battle",
      "kind": "bindBattleController",
      "parameters": {}
    },
    {
      "adapter": "Battle",
      "kind": "createAiBrain",
      "parameters": {
        "brainAssetAlias": "fireball_brain",
        "brainType": "attack"
      }
    }
  ],
  "runtimeActions": [
    {
      "adapter": "Battle",
      "kind": "executeAbility",
      "parameters": {
        "commandType": "fireball",
        "casterAlias": "p1_0",
        "targetCellAlias": "cell_1_0",
        "damage": 5,
        "manaCost": 0,
        "aoeCellAliases": ["cell_1_0"]
      }
    }
  ],
  "assertionPlans": [
    {
      "adapter": "Battle",
      "kind": "unitAliveEquals",
      "target": "p2_0",
      "expected": true,
      "parameters": {}
    }
  ],
  "timeoutMs": 15000,
  "probeRequests": [
    {
      "adapter": "Battle",
      "kind": "unitHealthEquals",
      "target": "p2_0",
      "parameters": {}
    }
  ]
}
