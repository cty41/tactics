{
  "schemaVersion": 1,
  "scenarioName": "Battle.FireballAoEDamage",
  "requiredAdapters": [
    "Battle",
    "Skill"
  ],
  "setupActions": [
    {
      "adapter": "Battle",
      "kind": "bindBattleController",
      "parameters": {}
    },
    {
      "adapter": "Skill",
      "kind": "createSkillGraph",
      "parameters": {
        "alias": "fireballGraph",
        "graphKind": "areaDamage",
        "baseDamage": 5,
        "radius": 1,
        "maxRange": 3
      }
    }
  ],
  "runtimeActions": [
    {
      "adapter": "Battle",
      "kind": "executeBattleSkillGraph",
      "parameters": {
        "graphAlias": "fireballGraph",
        "casterAlias": "p1_0",
        "targetAlias": "p2_0"
      }
    }
  ],
  "assertionPlans": [
    {
      "adapter": "Battle",
      "kind": "battleIsActive",
      "expected": true,
      "parameters": {}
    }
  ],
  "timeoutMs": 15000,
  "probeRequests": [
    {
      "adapter": "Battle",
      "kind": "battleIsActive",
      "parameters": {}
    }
  ]
}
