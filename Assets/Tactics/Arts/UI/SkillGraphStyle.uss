/* Skill Graph Editor Styles */

.graph-view {
    background-color: #1a1a1a;
}

.grid-background {
    background-color: #1a1a1a;
}

/* 入口节点 */
.node-start {
    background-color: #1a2e1a;
    border-width: 2px;
    border-color: #4caf50;
    border-radius: 8px;
    min-width: 140px;
}

.node-start .title {
    background-color: #388e3c;
    color: white;
    font-weight: bold;
    padding: 5px 10px;
    border-radius: 6px 6px 0 0;
}

/* 目标选择节点 */
.node-target {
    background-color: #182233;
    border-width: 2px;
    border-color: #4a90d9;
    border-radius: 8px;
    min-width: 170px;
}

.node-target .title {
    background-color: #4a90d9;
    color: white;
    font-weight: bold;
    padding: 5px 10px;
    border-radius: 6px 6px 0 0;
}

/* 流程控制节点 */
.node-flow {
    background-color: #2b2414;
    border-width: 2px;
    border-color: #d49a32;
    border-radius: 8px;
    min-width: 160px;
}

.node-flow .title {
    background-color: #c68725;
    color: white;
    font-weight: bold;
    padding: 5px 10px;
    border-radius: 6px 6px 0 0;
}

/* 位移节点 */
.node-movement {
    background-color: #1a2332;
    border-width: 2px;
    border-color: #5bc0de;
    border-radius: 8px;
    min-width: 170px;
}

.node-movement .title {
    background-color: #3a8fb7;
    color: white;
    font-weight: bold;
    padding: 5px 10px;
    border-radius: 6px 6px 0 0;
}

/* 效果节点 */
.node-effect {
    background-color: #2e1720;
    border-width: 2px;
    border-color: #e05555;
    border-radius: 8px;
    min-width: 160px;
}

.node-effect .title {
    background-color: #b53c3c;
    color: white;
    font-weight: bold;
    padding: 5px 10px;
    border-radius: 6px 6px 0 0;
}

/* 终止节点 */
.node-terminal {
    background-color: #22262d;
    border-width: 2px;
    border-color: #9aa4b2;
    border-radius: 8px;
    min-width: 120px;
}

.node-terminal .title {
    background-color: #687382;
    color: white;
    font-weight: bold;
    padding: 5px 10px;
    border-radius: 6px 6px 0 0;
}

/* 节点状态 */
.node-selected {
    border-width: 4px;
    border-color: #fff176;
}

.node-disabled {
    opacity: 0.42;
}

.node-disabled .title {
    background-color: #555555;
}

/* 端口样式 */
.port {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    background-color: #666;
    border-width: 2px;
    border-color: #999;
}

.port.input {
    margin-left: -6px;
}

.port.output {
    margin-right: -6px;
}

.port:hover {
    background-color: #4a90d9;
    border-color: #6ab0ff;
}

/* 连接线样式 */
.edge {
    stroke-width: 2px;
    stroke-color: #666;
}

.edge:hover {
    stroke-color: #4a90d9;
}
