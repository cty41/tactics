/* Treasure Panel UI Styles - Parchment Theme (FTL/BG3 style) */

.treasure-overlay {
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
    background-color: rgba(0, 0, 0, 0.65);
    padding: 20px;
    justify-content: center;
    align-items: center;
}

.treasure-panel {
    width: 420px;
    max-width: 85%;
    background-color: rgb(235, 222, 195);
    border-width: 4px;
    border-color: rgb(60, 50, 40);
    border-radius: 12px;
    flex-direction: column;
    padding: 28px 24px;
    align-items: center;
}

/* Title */
.treasure-title {
    font-size: 28px;
    color: rgb(180, 120, 40);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 20px;
    width: 100%;
}

/* Reward Section */
.reward-section {
    width: 100%;
    flex-direction: column;
    background-color: rgba(255, 255, 255, 0.35);
    border-width: 2px;
    border-color: rgb(180, 160, 130);
    border-radius: 8px;
    padding: 16px;
    margin-bottom: 20px;
}

.reward-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.reward-icon {
    margin-right: 12px;
    width: 36px;
    height: 28px;
    -unity-text-align: middle-center;
}

.reward-coin-icon {
    background-image: url("Icons/coin.svg");
    -unity-background-scale-mode: scale-to-fit;
}

.reward-sword-icon {
    background-image: url("Icons/sword.svg");
    -unity-background-scale-mode: scale-to-fit;
}

/* Gold Amount */
.gold-amount {
    font-size: 22px;
    color: rgb(180, 120, 40);
    -unity-font-style: bold;
}

/* Equipment Row */
.equipment-row {
    margin-top: 12px;
    padding-top: 12px;
    border-top-width: 2px;
    border-top-color: rgb(180, 160, 130);
}

.equipment-text {
    font-size: 18px;
    color: rgb(60, 130, 60);
    -unity-font-style: bold;
}

/* Confirm Button */
.confirm-btn {
    font-size: 18px;
    height: 44px;
    width: 100%;
    background-color: rgb(120, 100, 70);
    color: rgb(235, 222, 195);
    border-width: 2px;
    border-color: rgb(80, 65, 45);
    border-radius: 8px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.confirm-btn:hover {
    background-color: rgb(140, 120, 85);
}

.confirm-btn:active {
    background-color: rgb(100, 82, 55);
}
