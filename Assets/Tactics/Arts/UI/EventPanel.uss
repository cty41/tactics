/* Event Panel UI Styles - Parchment Theme (FTL/BG3 style) */

.event-overlay {
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
    background-color: rgba(0, 0, 0, 0.65);
    padding: 20px;
    justify-content: center;
    align-items: center;
}

.event-panel {
    width: 640px;
    max-width: 85%;
    max-height: 80%;
    background-color: rgb(235, 222, 195);
    border-width: 4px;
    border-color: rgb(60, 50, 40);
    border-radius: 12px;
    flex-direction: column;
    padding: 24px;
}

/* Title */
.event-title {
    font-size: 26px;
    color: rgb(60, 50, 40);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 8px;
    width: 100%;
}

/* Description */
.event-description {
    font-size: 15px;
    color: rgb(80, 70, 55);
    -unity-text-align: upper-left;
    white-space: normal;
    margin-bottom: 16px;
    width: 100%;
    padding-bottom: 12px;
    border-bottom-width: 2px;
    border-bottom-color: rgb(180, 160, 130);
}

/* Options Container */
.options-container {
    flex-grow: 1;
    min-height: 120px;
    max-height: 320px;
    margin-bottom: 12px;
}

/* Single Option Container */
.option-container {
    flex-direction: column;
    background-color: rgba(255, 255, 255, 0.35);
    border-width: 2px;
    border-color: rgb(180, 160, 130);
    border-radius: 8px;
    padding: 12px 16px;
    margin-bottom: 8px;
    transition-duration: 200ms;
    cursor: pointer;
}

.option-container:hover {
    background-color: rgba(200, 180, 150, 0.6);
    border-color: rgb(140, 120, 90);
}

/* Option text row */
.option-text-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
}

.option-text {
    font-size: 16px;
    color: rgb(50, 40, 30);
    -unity-font-style: bold;
    white-space: normal;
    flex-grow: 1;
}

.option-success-rate {
    font-size: 16px;
    -unity-font-style: bold;
    margin-left: 12px;
    min-width: 60px;
    -unity-text-align: middle-right;
}

/* Adjudicator info (BG3 style) */
.adjudicator-info {
    font-size: 12px;
    font-style: italic;
    color: rgb(120, 105, 85);
    margin-top: 4px;
    margin-left: 4px;
}

/* Success Rate Color Classes */
.success-rate-high {
    color: rgb(76, 175, 80);
}

.success-rate-mid {
    color: rgb(255, 193, 7);
}

.success-rate-low {
    color: rgb(244, 67, 54);
}

.auto-success {
    color: rgb(76, 175, 80);
}

/* Result Panel */
.result-panel {
    flex-direction: column;
    background-color: rgba(255, 255, 255, 0.3);
    border-width: 2px;
    border-color: rgb(180, 160, 130);
    border-radius: 8px;
    padding: 16px;
    margin-bottom: 16px;
}

.result-text {
    font-size: 16px;
    color: rgb(50, 40, 30);
    white-space: normal;
    -unity-text-align: upper-left;
    width: 100%;
}

.result-text.result-success {
    color: rgb(46, 125, 50);
}

.result-text.result-failure {
    color: rgb(198, 40, 40);
}

/* Continue Button */
.continue-btn {
    font-size: 18px;
    height: 44px;
    background-color: rgb(120, 100, 70);
    color: rgb(235, 222, 195);
    border-width: 2px;
    border-color: rgb(80, 65, 45);
    border-radius: 8px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    width: 100%;
}

.continue-btn:hover {
    background-color: rgb(140, 120, 85);
}

.continue-btn:active {
    background-color: rgb(100, 82, 55);
}
