<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Tactics/Arts/UI/EventPanel.uss?fileID=7433441132597879392&amp;guid=&amp;type=3#EventPanel"/>
    <ui:VisualElement name="EventOverlay" class="event-overlay">
        <ui:VisualElement name="EventPanel" class="event-panel">
            <ui:Label name="EventTitle" text="事件标题" class="event-title"/>
            <ui:Label name="EventDescription" text="事件描述" class="event-description"/>

            <ui:ScrollView name="OptionsContainer" class="options-container">
                <!-- Options are populated dynamically in code -->
            </ui:ScrollView>

            <ui:VisualElement name="ResultPanel" class="result-panel" style="display: none;">
                <ui:Label name="ResultText" text="结果文本" class="result-text"/>
            </ui:VisualElement>

            <ui:Button name="ContinueButton" text="继续" class="continue-btn" style="display: none;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
