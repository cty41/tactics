.overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.52);
    justify-content: center;
    align-items: center;
}

.panel {
    width: 460px;
    min-height: 520px;
    background-color: rgba(0, 0, 0, 0.94);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(249, 135, 75);
    padding: 32px;
    flex-direction: column;
}

.title {
    font-size: 34px;
    color: white;
    -unity-text-align: middle-center;
    margin-bottom: 12px;
}

.separator {
    height: 2px;
    background-color: rgb(249, 135, 75);
    margin-bottom: 16px;
}

.slot-list {
    flex-direction: column;
}

.slot-button {
    width: 100%;
    min-height: 78px;
    margin-bottom: 12px;
    background-color: rgba(0, 0, 0, 0.843);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(249, 135, 75);
    color: white;
    font-size: 16px;
    -unity-text-align: middle-center;
}

.message-label {
    min-height: 22px;
    color: rgb(249, 135, 75);
    font-size: 14px;
    -unity-text-align: middle-center;
    margin-bottom: 10px;
}

.button-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 12px;
}

.button,
.back-button {
    height: 44px;
    background-color: rgba(0, 0, 0, 0.843);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(249, 135, 75);
    color: white;
    font-size: 16px;
}

.button {
    width: 180px;
}

.danger-button {
    border-color: rgb(220, 75, 75);
}

.back-button {
    width: 100%;
}
