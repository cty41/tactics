.root-container {
    width: 100%;
    height: 100%;
    position: relative;
}

.top-panel {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    flex-direction: row;
    align-items: flex-start;
    gap: 10px;
    padding-top: 10px;
    padding-left: 20px;
    padding-right: 20px;
    padding-bottom: 10px;
}

.status-panel {
    flex-direction: column;
    gap: 8px;
    width: 200px;
}

.bottom-panel {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    padding-top: 10px;
    padding-left: 20px;
    padding-right: 20px;
    padding-bottom: 20px;
}

.left-panel {
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
}

.right-panel {
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
}

.button {
    width: 120px;
    height: 48px;
    flex-grow: 0;
    flex-shrink: 0;
    background-color: rgba(40, 40, 40, 0.85);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgba(100, 100, 100, 0.9);
    color: white;
    font-size: 16px;
    text-align: middle-center;
    cursor: pointer;
}

.button:hover {
    background-color: rgba(60, 60, 60, 0.9);
    border-color: rgb(150, 150, 150);
}

.button:active {
    background-color: rgba(80, 80, 80, 0.95);
}

.move-button {
    width: 180px;
}

.end-turn-button {
    width: 140px;
    background-color: rgba(180, 40, 40, 0.85);
    border-color: rgba(220, 80, 80, 0.9);
}

.end-turn-button:hover {
    background-color: rgba(200, 60, 60, 0.9);
    border-color: rgb(240, 100, 100);
}

.end-turn-button:active {
    background-color: rgba(220, 80, 80, 0.95);
}

#hp .unity-progress-bar__progress {
    background-color: rgb(76, 175, 80);
}

#mp .unity-progress-bar__progress {
    background-color: rgb(33, 150, 243);
}
