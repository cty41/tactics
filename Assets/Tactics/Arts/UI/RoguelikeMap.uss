.root-container {
    width: 100%;
    height: 100%;
    position: relative;
}

.map-scroll-view {
    width: 100%;
    height: 100%;
}

.background-layer {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
}

.lines-layer {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

.nodes-layer {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

.map-node {
    position: absolute;
    width: 64px;
    height: 64px;
}

.map-node-icon {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.visited-indicator {
    position: absolute;
    left: -8px;
    top: -8px;
    width: 80px;
    height: 80px;
    display: none;
    border-radius: 50%;
    border-width: 4px;
    border-color: rgb(255, 255, 255);
}

.swirl-fill {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    display: none;
}
