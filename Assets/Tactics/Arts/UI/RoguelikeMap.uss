.root-container {
    width: 100%;
    height: 100%;
    position: relative;
}

.map-scroll-view {
    width: 100%;
    height: 100%;
}

.background-layer {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
}

.lines-layer {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

.nodes-layer {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

.map-node {
    position: absolute;
    width: 64px;
    height: 64px;
}

.map-node-icon {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.visited-indicator {
    position: absolute;
    left: -8px;
    top: -8px;
    width: 80px;
    height: 80px;
    display: none;
    border-radius: 50%;
    border-width: 4px;
    border-color: rgb(255, 255, 255);
}

.swirl-fill {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    display: none;
}

/* ---- HUD Styles ---- */

.top-bar {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 80px;
    background-color: rgba(240, 240, 240, 0.9);
    border-bottom-width: 3px;
    border-bottom-color: rgb(40, 40, 40);
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 8px;
    padding-bottom: 8px;
}

.top-bar-left {
    flex-direction: row;
    align-items: center;
}

.top-bar-right {
    flex-direction: row;
    align-items: center;
}

.hud-button {
    width: 48px;
    height: 48px;
    background-color: rgb(200, 200, 200);
    border-width: 2px;
    border-color: rgb(40, 40, 40);
    border-radius: 8px;
    font-size: 24px;
    -unity-text-align: middle-center;
    margin-right: 8px;
}

.resource-item {
    flex-direction: row;
    align-items: center;
    margin-left: 12px;
}

.resource-icon {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    margin-right: 4px;
}

.gold-icon {
    background-color: rgb(255, 215, 0);
}

.food-icon {
    background-color: rgb(210, 105, 30);
}

.resource-label {
    font-size: 20px;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
    -unity-font-style: bold;
}

/* ---- Party Panel Styles ---- */

.party-panel {
    position: absolute;
    left: 12px;
    top: 100px;
    width: 140px;
    flex-direction: column;
}

.party-slot {
    width: 120px;
    background-color: rgba(255, 255, 255, 0.95);
    border-width: 2px;
    border-color: rgb(40, 40, 40);
    border-radius: 8px;
    padding: 8px;
    margin-bottom: 12px;
    align-items: center;
}

.party-avatar {
    width: 64px;
    height: 64px;
    background-color: rgb(140, 140, 140);
    border-radius: 8px;
    margin-bottom: 4px;
}

.party-name {
    font-size: 14px;
    color: rgb(40, 40, 40);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.hp-bar-background {
    width: 100%;
    height: 12px;
    background-color: rgb(80, 80, 80);
    border-radius: 6px;
    margin-bottom: 4px;
    overflow: hidden;
}

.hp-bar-fill {
    width: 80%;
    height: 100%;
    background-color: rgb(200, 60, 60);
    border-radius: 6px;
}

.party-level {
    font-size: 12px;
    color: rgb(80, 80, 80);
    -unity-text-align: middle-center;
}