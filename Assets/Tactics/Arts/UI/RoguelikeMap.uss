.root-container {
    width: 100%;
    height: 100%;
    position: relative;
}

.map-scroll-view {
    width: 100%;
    height: 100%;
}

.background-layer {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
}

.lines-layer {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

.nodes-layer {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

.map-node {
    position: absolute;
    width: 64px;
    height: 64px;
}

.map-node-icon {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.visited-indicator {
    position: absolute;
    left: -8px;
    top: -8px;
    width: 80px;
    height: 80px;
    display: none;
    border-radius: 50%;
    border-width: 4px;
    border-color: rgb(255, 255, 255);
}

.swirl-fill {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    display: none;
}

/* ---- HUD Styles ---- */

.top-bar {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 64px;
    background-color: rgba(0, 0, 0, 0.85);
    border-bottom-width: 2px;
    border-bottom-color: rgb(249, 135, 75);
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-left: 12px;
    padding-right: 16px;
    padding-top: 8px;
    padding-bottom: 8px;
}

.top-bar-left {
    flex-direction: row;
    align-items: center;
}

.top-bar-right {
    flex-direction: row;
    align-items: center;
}

.hud-button {
    height: 40px;
    min-width: 96px;
    padding-left: 14px;
    padding-right: 14px;
    background-color: rgba(0, 0, 0, 0.84);
    border-width: 2px;
    border-color: rgb(249, 135, 75);
    border-radius: 8px;
    color: rgb(255, 255, 255);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-right: 8px;
}

.hud-button:hover {
    background-color: rgba(30, 30, 30, 0.9);
    border-color: rgb(255, 160, 100);
}

.hud-button:active {
    background-color: rgba(50, 50, 50, 0.95);
}

.resource-item {
    flex-direction: row;
    align-items: center;
    margin-left: 12px;
}

.resource-icon {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    margin-right: 4px;
}

.gold-icon {
    background-color: rgb(255, 215, 0);
}

.resource-label {
    font-size: 20px;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
    -unity-font-style: bold;
}

/* ---- Party Panel Styles ---- */

.party-panel {
    position: absolute;
    left: 12px;
    top: 100px;
    width: 140px;
    flex-direction: column;
}

.party-slot {
    width: 120px;
    background-color: rgba(0, 0, 0, 0.84);
    border-width: 2px;
    border-color: rgb(249, 135, 75);
    border-radius: 8px;
    padding: 8px;
    margin-bottom: 12px;
    align-items: center;
}

.party-avatar {
    width: 64px;
    height: 64px;
    background-color: rgb(45, 45, 45);
    border-radius: 8px;
    margin-bottom: 4px;
}

.party-name {
    font-size: 16px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.hp-bar-background {
    width: 100%;
    height: 12px;
    background-color: rgb(60, 60, 60);
    border-radius: 6px;
    margin-bottom: 4px;
    overflow: hidden;
}

.hp-bar-fill {
    width: 80%;
    height: 100%;
    background-color: rgb(200, 60, 60);
    border-radius: 6px;
}

.party-level {
    font-size: 16px;
    color: rgb(190, 190, 190);
    -unity-text-align: middle-center;
}

.party-vitals {
    font-size: 12px;
    color: rgb(190, 190, 190);
    -unity-text-align: middle-center;
}

.party-dead {
    opacity: 0.55;
    border-color: rgb(130, 25, 25);
}
