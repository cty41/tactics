/* Skill Selection UI Styles */
/* Matches Inventory theme: parchment panel with dark overlay */

.skill-selection-root {
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
    background-color: rgba(0, 0, 0, 0.6);
    padding: 24px;
    justify-content: center;
    align-items: center;
}

.skill-selection-panel {
    width: 600px;
    max-width: 80%;
    background-color: rgb(235, 222, 195);
    border-width: 4px;
    border-color: rgb(60, 50, 40);
    border-radius: 12px;
    flex-direction: column;
    padding: 24px;
    align-items: center;
}

/* Title */
.title-label {
    font-size: 28px;
    color: rgb(60, 50, 40);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 4px;
    width: 100%;
}

.subtitle-label {
    font-size: 16px;
    color: rgb(120, 100, 80);
    -unity-text-align: middle-center;
    margin-bottom: 20px;
    width: 100%;
}

/* Skills Container */
.skills-container {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 16px;
}

/* Single Skill Option */
.skill-option {
    width: 30%;
    min-width: 140px;
    background-color: rgba(255, 255, 255, 0.4);
    border-width: 2px;
    border-color: rgb(180, 160, 130);
    border-radius: 8px;
    padding: 12px;
    flex-direction: column;
    align-items: center;
    transition-duration: 200ms;
    cursor: pointer;
}

.skill-option:hover {
    background-color: rgba(200, 180, 150, 0.6);
    border-color: rgb(140, 120, 90);
}

.skill-option:focus {
    background-color: rgba(180, 160, 130, 0.7);
    border-color: rgb(100, 80, 60);
}

.skill-option.selected {
    background-color: rgba(160, 200, 160, 0.5);
    border-color: rgb(80, 140, 80);
    border-width: 3px;
}

.skill-name {
    font-size: 20px;
    color: rgb(60, 50, 40);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 4px;
    white-space: normal;
}

.skill-type {
    font-size: 13px;
    color: rgb(140, 100, 60);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 2px;
    padding: 2px 8px;
    background-color: rgba(180, 160, 130, 0.3);
    border-radius: 4px;
}

.skill-level {
    font-size: 14px;
    color: rgb(100, 80, 60);
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}

.skill-desc {
    font-size: 13px;
    color: rgb(100, 85, 65);
    -unity-text-align: middle-center;
    white-space: normal;
    overflow: hidden;
}

/* Replace Section */
.replace-section {
    width: 100%;
    flex-direction: column;
    align-items: center;
    background-color: rgba(200, 180, 150, 0.4);
    border-width: 2px;
    border-color: rgb(180, 160, 130);
    border-radius: 8px;
    padding: 12px;
    margin-bottom: 16px;
}

.replace-title {
    font-size: 15px;
    color: rgb(160, 80, 60);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 10px;
    width: 100%;
}

.replace-options {
    width: 100%;
    flex-direction: row;
    justify-content: center;
    flex-wrap: wrap;
}

.replace-option {
    background-color: rgba(180, 100, 80, 0.3);
    border-width: 2px;
    border-color: rgb(160, 80, 60);
    border-radius: 6px;
    padding: 8px 16px;
    margin: 4px;
    font-size: 14px;
    color: rgb(60, 50, 40);
    cursor: pointer;
    -unity-text-align: middle-center;
}

.replace-option:hover {
    background-color: rgba(180, 100, 80, 0.5);
    border-color: rgb(140, 60, 40);
}

.replace-option:focus {
    background-color: rgba(180, 100, 80, 0.7);
    border-color: rgb(120, 40, 20);
}

/* Confirm Button */
.confirm-button {
    width: 200px;
    height: 44px;
    background-color: rgb(100, 160, 100);
    border-width: 2px;
    border-color: rgb(60, 50, 40);
    border-radius: 8px;
    font-size: 20px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    cursor: pointer;
    margin-top: 8px;
}

.confirm-button:hover {
    background-color: rgb(120, 180, 120);
}

.confirm-button:focus {
    background-color: rgb(80, 140, 80);
}

.confirm-button:disabled {
    background-color: rgb(160, 160, 160);
    border-color: rgb(140, 140, 140);
    color: rgb(200, 200, 200);
    cursor: default;
}
