<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Tactics/Arts/UI/RunEndSummary.uss?fileID=7433441132597879392&amp;guid=25cfc1cf035e57a4ba6a7bdf03a27fbf&amp;type=3#RunEndSummary"/>
    <ui:VisualElement name="RunEndSummaryRoot" class="run-end-summary-root">
        <ui:VisualElement name="RunEndSummaryPanel" class="run-end-summary-panel">
            <ui:Label name="TitleLabel" text="Run 完成！" class="title-label victory"/>
            <ui:VisualElement name="GoldSection" class="gold-section">
                <ui:Label text="获得金币" class="section-title"/>
                <ui:Label name="GoldLabel" text="0" class="gold-label"/>
            </ui:VisualElement>
            <ui:VisualElement name="StatsSection" class="stats-section">
                <ui:Label text="统计" class="section-title"/>
                <ui:Label name="StatsLabel" text="" class="stats-label"/>
            </ui:VisualElement>
            <ui:VisualElement name="EquipmentSection" class="equipment-section">
                <ui:Label text="获得装备" class="section-title"/>
                <ui:Label name="EquipmentLabel" text="" class="equipment-label"/>
            </ui:VisualElement>
            <ui:VisualElement name="ItemsSection" class="items-section">
                <ui:Label text="获得物品" class="section-title"/>
                <ui:Label name="ItemsLabel" text="" class="items-label"/>
            </ui:VisualElement>
            <ui:VisualElement name="BossStatusSection" class="boss-status-section">
                <ui:Label name="BossStatusLabel" text="" class="boss-status-label"/>
            </ui:VisualElement>
            <ui:Button name="ReturnHomeButton" text="返回避难所" class="return-home-button"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
