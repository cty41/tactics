/* Run End Summary UI Styles */

.run-end-summary-root {
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
    background-color: rgba(0, 0, 0, 0.8);
    padding: 24px;
}

.run-end-summary-panel {
    width: 500px;
    height: auto;
    max-height: 90%;
    border-radius: 15px;
    flex-direction: column;
    padding: 30px;
    align-self: center;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

/* Victory Theme */
.run-end-summary-panel.victory {
    background-color: rgb(25, 75, 25);
}

/* Defeat Theme */
.run-end-summary-panel.defeat {
    background-color: rgb(75, 25, 25);
}

/* Title */
.title-label {
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 20px;
}

.title-label.victory {
    color: rgb(50, 230, 50);
}

.title-label.defeat {
    color: rgb(230, 50, 50);
}

/* Section */
.section-title {
    font-size: 18px;
    color: rgba(255, 255, 255, 0.8);
    -unity-font-style: bold;
    margin-bottom: 8px;
    -unity-text-align: middle-center;
}

/* Gold */
.gold-section {
    width: 100%;
    flex-direction: column;
    align-items: center;
    margin-bottom: 16px;
}

.gold-label {
    font-size: 24px;
    color: rgb(255, 215, 0);
    -unity-font-style: bold;
}

/* Stats */
.stats-section {
    width: 100%;
    flex-direction: column;
    align-items: center;
    margin-bottom: 16px;
}

.stats-label {
    font-size: 16px;
    color: white;
    -unity-text-align: middle-center;
}

/* Equipment & Items */
.equipment-section,
.items-section {
    width: 100%;
    flex-direction: column;
    align-items: center;
    margin-bottom: 16px;
    display: none;
}

.equipment-label,
.items-label {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.9);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* Boss Status */
.boss-status-section {
    width: 100%;
    flex-direction: column;
    align-items: center;
    margin-bottom: 20px;
}

.boss-status-label {
    font-size: 18px;
    color: rgb(255, 215, 0);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* Return Button */
.return-home-button {
    width: 80%;
    height: 50px;
    font-size: 20px;
    background-color: rgb(200, 150, 50);
    border-width: 2px;
    border-color: rgb(150, 100, 30);
    border-radius: 10px;
    color: white;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-top: 10px;
}

.return-home-button:hover {
    background-color: rgb(220, 170, 70);
}

.return-home-button:active {
    background-color: rgb(180, 130, 40);
}
