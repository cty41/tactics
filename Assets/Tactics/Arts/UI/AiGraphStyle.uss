/* AI Decision Graph Editor Styles */

.graph-view {
    background-color: #1a1a1a;
}

.grid-background {
    background-color: #1a1a1a;
}

/* 意图节点样式 */
.intent-node {
    background-color: #182233;
    border-width: 2px;
    border-color: #4a90d9;
    border-radius: 8px;
    min-width: 170px;
}

.intent-node .title {
    background-color: #4a90d9;
    color: white;
    font-weight: bold;
    padding: 5px 10px;
    border-radius: 6px 6px 0 0;
}

.intent-node .node-content {
    padding: 10px;
}

/* 规则节点样式 */
.rule-node {
    background-color: #17261f;
    border-width: 2px;
    border-color: #4fb06f;
    border-radius: 8px;
    min-width: 170px;
}

.rule-node .title {
    background-color: #3f9d63;
    color: white;
    font-weight: bold;
    padding: 5px 10px;
    border-radius: 6px 6px 0 0;
}

.rule-node .node-content {
    padding: 10px;
}

/* 评分节点样式 */
.score-node {
    background-color: #2b2414;
    border-width: 2px;
    border-color: #d49a32;
    border-radius: 8px;
    min-width: 170px;
}

.score-node .title {
    background-color: #c68725;
    color: white;
    font-weight: bold;
    padding: 5px 10px;
    border-radius: 6px 6px 0 0;
}

.score-node .node-content {
    padding: 10px;
}

/* Intent 语义色 */
.intent-finish-off {
    border-color: #ff6b45;
    background-color: #321a16;
}

.intent-finish-off .title {
    background-color: #c7472d;
}

.intent-basic-attack {
    border-color: #ff9f43;
    background-color: #342315;
}

.intent-basic-attack .title {
    background-color: #c56f22;
}

.intent-engage {
    border-color: #4a90d9;
    background-color: #182433;
}

.intent-engage .title {
    background-color: #326ca8;
}

.intent-ability-use {
    border-color: #9b7cff;
    background-color: #251f3c;
}

.intent-ability-use .title {
    background-color: #6950c8;
}

.intent-retreat {
    border-color: #38c4a3;
    background-color: #142d2b;
}

.intent-retreat .title {
    background-color: #218f7d;
}

.intent-hold-position {
    border-color: #9aa4b2;
    background-color: #22262d;
}

.intent-hold-position .title {
    background-color: #687382;
}

/* Rule 语义色 */
.rule-target {
    border-color: #7ed957;
}

.rule-target .title {
    background-color: #4f9e3e;
}

.rule-health {
    border-color: #ff6f7a;
    background-color: #2e171c;
}

.rule-health .title {
    background-color: #bd3e4b;
}

.rule-safety {
    border-color: #35c5b2;
    background-color: #142b29;
}

.rule-safety .title {
    background-color: #208d83;
}

.rule-ability {
    border-color: #8e7cff;
    background-color: #211d37;
}

.rule-ability .title {
    background-color: #5d4fb5;
}

.rule-utility {
    border-color: #8ba0b7;
    background-color: #20252c;
}

.rule-utility .title {
    background-color: #5f7186;
}

/* Score 语义色 */
.score-offense {
    border-color: #ffb347;
}

.score-offense .title {
    background-color: #c57922;
}

.score-position {
    border-color: #55b7ff;
    background-color: #152636;
}

.score-position .title {
    background-color: #2e78ae;
}

.score-health {
    border-color: #ff7480;
    background-color: #2c181c;
}

.score-health .title {
    background-color: #b84551;
}

.score-ability {
    border-color: #a88cff;
    background-color: #241d3a;
}

.score-ability .title {
    background-color: #6d55bf;
}

.score-utility {
    border-color: #d0aa5a;
    background-color: #2c2618;
}

.score-utility .title {
    background-color: #9b7a35;
}

/* 节点状态 */
.node-selected {
    border-width: 4px;
    border-color: #fff176;
}

.node-disabled {
    opacity: 0.42;
}

.node-disabled .title {
    background-color: #555555;
}

.node-orphan {
    border-width: 3px;
    border-color: #ff3d3d;
}

.node-orphan .title {
    background-color: #9b2727;
}

/* 端口样式 */
.port {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    background-color: #666;
    border-width: 2px;
    border-color: #999;
}

.port.input {
    margin-left: -6px;
}

.port.output {
    margin-right: -6px;
}

.port:hover {
    background-color: #4a90d9;
    border-color: #6ab0ff;
}

/* 连接线样式 */
.edge {
    stroke-width: 2px;
    stroke-color: #666;
}

.edge:hover {
    stroke-color: #4a90d9;
}

/* Inspector 样式 */
.inspector {
    background-color: #252525;
    padding: 10px;
}

.inspector label {
    color: #ccc;
}

.inspector .title {
    color: white;
    font-weight: bold;
    font-size: 14px;
    margin-bottom: 10px;
}
