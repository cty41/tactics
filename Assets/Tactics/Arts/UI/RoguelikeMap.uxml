<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Tactics/Arts/UI/RoguelikeMap.uss?fileID=7433441132597879392&amp;guid=c9a8017f29d7da349a4b753adb0f9b36&amp;type=3#RoguelikeMap"/>
    <ui:VisualElement name="RootContainer" class="root-container">
        <ui:ScrollView name="MapScrollView" mode="VerticalAndHorizontal" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" class="map-scroll-view">
            <ui:VisualElement name="MapContainer" class="map-container">
                <ui:VisualElement name="BackgroundLayer" picking-mode="Ignore" class="background-layer"/>
                <ui:VisualElement name="LinesLayer" picking-mode="Ignore" class="lines-layer"/>
                <ui:VisualElement name="NodesLayer" class="nodes-layer"/>
            </ui:VisualElement>
        </ui:ScrollView>
        <ui:VisualElement name="TopBar" class="top-bar">
            <ui:VisualElement name="TopBarLeft" class="top-bar-left">
                <ui:Button name="SettingsButton" text="MENU" class="hud-button"/>
                <ui:Button name="InventoryButton" text="INVENTORY" class="hud-button"/>
            </ui:VisualElement>
            <ui:VisualElement name="TopBarRight" class="top-bar-right">
                <ui:VisualElement name="GoldContainer" class="resource-item">
                    <ui:VisualElement name="GoldIcon" class="resource-icon gold-icon"/>
                    <ui:Label name="GoldLabel" text="0" class="resource-label"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="PartyPanel" class="party-panel"/>

    </ui:VisualElement>
</ui:UXML>
