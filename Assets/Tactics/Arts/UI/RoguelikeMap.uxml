<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="RootContainer" class="root-container">
        <ui:ScrollView name="MapScrollView" mode="Horizontal" horizontal-scroller-visibility="Auto" vertical-scroller-visibility="Hidden" class="map-scroll-view">
            <ui:VisualElement name="MapContainer" class="map-container">
                <ui:VisualElement name="BackgroundLayer" picking-mode="Ignore" class="background-layer"/>
                <ui:VisualElement name="LinesLayer" picking-mode="Ignore" class="lines-layer"/>
                <ui:VisualElement name="NodesLayer" class="nodes-layer"/>
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
