/* Level Up Panel UI Styles - Parchment Theme */

.levelup-overlay {
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
    background-color: rgba(0, 0, 0, 0.6);
    padding: 20px;
}

.levelup-panel {
    width: 100%;
    height: 100%;
    background-color: rgb(235, 222, 195);
    border-width: 4px;
    border-color: rgb(60, 50, 40);
    border-radius: 12px;
    flex-direction: column;
    padding: 16px;
}

.levelup-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
    padding: 8px 12px;
    background-color: rgba(255, 255, 255, 0.3);
    border-width: 2px;
    border-color: rgb(180, 160, 130);
    border-radius: 8px;
}

.char-name {
    font-size: 22px;
    color: rgb(60, 50, 40);
    -unity-font-style: bold;
}

.char-level {
    font-size: 16px;
    color: rgb(120, 100, 80);
}

.points-label {
    font-size: 16px;
    color: rgb(180, 120, 40);
    -unity-font-style: bold;
}

.main-content {
    flex-grow: 1;
    flex-direction: row;
    margin-bottom: 12px;
}

.left-panel {
    width: 30%;
    flex-direction: column;
    margin-right: 8px;
    padding: 4px;
}

.right-panel {
    width: 70%;
    flex-direction: column;
    margin-left: 8px;
    padding: 8px;
}

#AttributeRows {
    flex-grow: 1;
    min-height: 100px;
    margin-bottom: 8px;
}

.section-title {
    font-size: 16px;
    color: rgb(60, 50, 40);
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.attr-row {
    flex-direction: row;
    align-items: center;
    padding: 3px 6px;
    margin-bottom: 3px;
    background-color: rgba(255, 255, 255, 0.2);
    border-width: 1px;
    border-color: rgb(200, 180, 150);
    border-radius: 6px;
    min-height: 32px;
}

.attr-row:hover {
    background-color: rgba(255, 255, 255, 0.4);
}

.attr-name {
    width: 50px;
    font-size: 16px;
    color: rgb(60, 50, 40);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.attr-value {
    width: 36px;
    font-size: 16px;
    color: rgb(80, 70, 60);
    -unity-text-align: middle-center;
}

.attr-allocated {
    width: 36px;
    font-size: 14px;
    color: rgb(60, 130, 60);
    -unity-text-align: middle-center;
}

.attr-btn {
    width: 28px;
    height: 28px;
    font-size: 18px;
    -unity-text-align: middle-center;
    border-width: 2px;
    border-color: rgb(120, 100, 80);
    border-radius: 4px;
}

.attr-btn-minus {
    background-color: rgb(200, 160, 120);
    color: rgb(60, 50, 40);
}

.attr-btn-minus:hover {
    background-color: rgb(180, 140, 100);
}

.attr-btn-plus {
    background-color: rgb(160, 200, 160);
    color: rgb(40, 80, 40);
}

.attr-btn-plus:hover {
    background-color: rgb(140, 180, 140);
}

.derived-section {
    margin-top: 12px;
    padding-top: 8px;
    border-top-width: 1px;
    border-top-color: rgb(180, 160, 130);
}

.derived-title {
    font-size: 18px;
    color: rgb(120, 100, 80);
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.derived-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 2px 0;
}

.derived-name {
    font-size: 16px;
    color: rgb(120, 100, 80);
    -unity-font-style: bold;
}

.derived-value {
    font-size: 16px;
    color: rgb(60, 50, 40);
    -unity-font-style: bold;
}

.skill-card {
    flex-direction: column;
    padding: 12px;
    margin: 4px;
    background-color: rgba(255, 255, 255, 0.5);
    border-width: 2px;
    border-color: rgb(180, 160, 130);
    border-radius: 8px;
    border-left-width: 5px;
    transition-duration: 0.15s;
    transition-property: border-color, background-color;
}

.skill-card:hover {
    background-color: rgba(220, 200, 170, 0.7);
    border-color: rgb(160, 130, 100);
}

.skill-card.selected {
    background-color: rgba(160, 210, 160, 0.7);
    border-color: rgb(80, 160, 80);
    border-left-color: rgb(60, 140, 60);
}

.skill-card-active {
    border-left-color: rgb(180, 60, 40);
}

.skill-card-passive {
    border-left-color: rgb(60, 120, 180);
}

.skill-card-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.skill-name {
    font-size: 20px;
    color: rgb(60, 50, 40);
    -unity-font-style: bold;
}

.skill-type-badge {
    font-size: 13px;
    padding: 3px 10px;
    border-radius: 4px;
    -unity-font-style: bold;
}

.skill-card-active .skill-type-badge {
    background-color: rgba(180, 60, 40, 0.2);
    color: rgb(180, 60, 40);
}

.skill-card-passive .skill-type-badge {
    background-color: rgba(60, 120, 180, 0.2);
    color: rgb(60, 120, 180);
}

.skill-desc {
    font-size: 15px;
    color: rgb(100, 80, 60);
    margin-top: 6px;
    white-space: normal;
}

.confirm-btn {
    margin-top: 12px;
    height: 44px;
    font-size: 18px;
    -unity-font-style: bold;
    background-color: rgb(180, 150, 100);
    color: rgb(60, 50, 40);
    border-width: 2px;
    border-color: rgb(120, 100, 80);
    border-radius: 6px;
}

.confirm-btn:hover {
    background-color: rgb(200, 170, 120);
}

.confirm-btn:disabled {
    background-color: rgb(160, 150, 140);
    color: rgb(120, 110, 100);
}

.skill-section-title {
    font-size: 16px;
    color: rgb(60, 50, 40);
    -unity-font-style: bold;
    margin-bottom: 6px;
    margin-top: 8px;
}



.skill-section-header {
    flex-direction: row;
    align-items: center;
    margin-top: 12px;
    margin-bottom: 8px;
    padding: 6px 10px;
    background-color: rgba(180, 150, 100, 0.3);
    border-radius: 6px;
    border-left-width: 4px;
    border-left-color: rgb(180, 120, 40);
}

.section-header-icon {
    font-size: 16px;
    color: rgb(180, 120, 40);
    margin-right: 8px;
}

.section-header-title {
    font-size: 18px;
    color: rgb(60, 50, 40);
    -unity-font-style: bold;
}

.skill-sub-title {
    font-size: 14px;
    color: rgb(120, 100, 80);
    margin-top: 6px;
    margin-bottom: 4px;
    padding-left: 4px;
}

.current-skills-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 6px;
}

.current-skill-icon {
    flex-direction: row;
    align-items: center;
    padding: 6px 10px;
    margin: 3px;
    background-color: rgba(255, 255, 255, 0.35);
    border-width: 1px;
    border-color: rgb(200, 180, 150);
    border-radius: 6px;
    min-height: 36px;
}

.current-skill-name {
    font-size: 15px;
    color: rgb(60, 50, 40);
    -unity-font-style: bold;
    margin-left: 4px;
    margin-right: 8px;
}

.current-skill-active {
    width: 4px;
    height: 4px;
    background-color: rgb(180, 60, 40);
    border-radius: 2px;
    margin-right: 4px;
}

.current-skill-passive {
    width: 4px;
    height: 4px;
    background-color: rgb(60, 120, 180);
    border-radius: 2px;
    margin-right: 4px;
}

.skill-level-badge {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(120, 100, 60);
    background-color: rgba(200, 180, 140, 0.4);
    border-radius: 3px;
    padding: 1px 5px;
}

.skill-card-level {
    position: absolute;
    top: 6px;
    right: 6px;
}

.skill-card-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.skill-stats-row {
    flex-direction: row;
    justify-content: flex-start;
    margin-top: 8px;
}

.skill-stat-damage {
    font-size: 15px;
    -unity-font-style: bold;
    margin-right: 4px;
}

.skill-card-active .skill-stat-damage {
    color: rgb(180, 60, 40);
}

.skill-stat-mp {
    font-size: 15px;
    -unity-font-style: bold;
    margin-right: 4px;
}

.skill-card-active .skill-stat-mp {
    color: rgb(40, 80, 180);
}

.skill-stat-group {
    flex-direction: row;
    align-items: center;
    margin-right: 16px;
}

.skill-stat-icon {
    width: 14px;
    height: 14px;
    margin-right: 4px;
}

.skill-stat-sword-icon {
    background-image: url("Icons/sword.svg");
    -unity-background-scale-mode: scale-to-fit;
}

.skill-card-passive {
    border-left-color: rgb(60, 120, 180);
}
