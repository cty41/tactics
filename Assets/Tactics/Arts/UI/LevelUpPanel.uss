/* Level Up Panel UI Styles - Parchment Theme */

.levelup-overlay {
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
    background-color: rgba(0, 0, 0, 0.6);
    padding: 20px;
}

.levelup-panel {
    width: 100%;
    height: 100%;
    background-color: rgb(235, 222, 195);
    border-width: 4px;
    border-color: rgb(60, 50, 40);
    border-radius: 12px;
    flex-direction: column;
    padding: 16px;
}

.levelup-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
    padding: 8px 12px;
    background-color: rgba(255, 255, 255, 0.3);
    border-width: 2px;
    border-color: rgb(180, 160, 130);
    border-radius: 8px;
}

.char-name {
    font-size: 22px;
    color: rgb(60, 50, 40);
    -unity-font-style: bold;
}

.char-level {
    font-size: 16px;
    color: rgb(120, 100, 80);
}

.points-label {
    font-size: 16px;
    color: rgb(180, 120, 40);
    -unity-font-style: bold;
}

.main-content {
    flex-grow: 1;
    flex-direction: row;
    margin-bottom: 12px;
}

.left-panel {
    width: 55%;
    flex-direction: column;
    margin-right: 8px;
    padding: 8px;
}

.right-panel {
    width: 45%;
    flex-direction: column;
    margin-left: 8px;
    padding: 8px;
}

#AttributeRows {
    flex-grow: 1;
    min-height: 100px;
    margin-bottom: 8px;
}

.section-title {
    font-size: 16px;
    color: rgb(60, 50, 40);
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.attr-row {
    flex-direction: row;
    align-items: center;
    padding: 3px 6px;
    margin-bottom: 3px;
    background-color: rgba(255, 255, 255, 0.2);
    border-width: 1px;
    border-color: rgb(200, 180, 150);
    border-radius: 6px;
    min-height: 32px;
}

.attr-row:hover {
    background-color: rgba(255, 255, 255, 0.4);
}

.attr-name {
    width: 50px;
    font-size: 16px;
    color: rgb(60, 50, 40);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.attr-value {
    width: 36px;
    font-size: 16px;
    color: rgb(80, 70, 60);
    -unity-text-align: middle-center;
}

.attr-allocated {
    width: 36px;
    font-size: 14px;
    color: rgb(60, 130, 60);
    -unity-text-align: middle-center;
}

.attr-btn {
    width: 28px;
    height: 28px;
    font-size: 18px;
    -unity-text-align: middle-center;
    border-width: 2px;
    border-color: rgb(120, 100, 80);
    border-radius: 4px;
}

.attr-btn-minus {
    background-color: rgb(200, 160, 120);
    color: rgb(60, 50, 40);
}

.attr-btn-minus:hover {
    background-color: rgb(180, 140, 100);
}

.attr-btn-plus {
    background-color: rgb(160, 200, 160);
    color: rgb(40, 80, 40);
}

.attr-btn-plus:hover {
    background-color: rgb(140, 180, 140);
}

.derived-section {
    margin-top: 12px;
    padding-top: 8px;
    border-top-width: 1px;
    border-top-color: rgb(180, 160, 130);
}

.derived-title {
    font-size: 15px;
    color: rgb(120, 100, 80);
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.derived-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 1px 0;
}

.derived-name {
    font-size: 14px;
    color: rgb(120, 100, 80);
}

.derived-value {
    font-size: 14px;
    color: rgb(60, 50, 40);
    -unity-font-style: bold;
}

.skill-card {
    flex-direction: column;
    padding: 10px;
    margin-bottom: 6px;
    background-color: rgba(255, 255, 255, 0.4);
    border-width: 2px;
    border-color: rgb(180, 160, 130);
    border-radius: 8px;
    border-left-width: 4px;
    border-left-color: rgb(180, 160, 130);
}

.skill-card:hover {
    background-color: rgba(200, 180, 150, 0.6);
    border-color: rgb(140, 120, 90);
}

.skill-card.selected {
    background-color: rgba(160, 210, 160, 0.6);
    border-color: rgb(80, 140, 80);
    border-left-color: rgb(80, 160, 80);
}

.skill-card-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.skill-name {
    font-size: 16px;
    color: rgb(60, 50, 40);
    -unity-font-style: bold;
}

.skill-type-badge {
    font-size: 11px;
    color: rgb(140, 100, 60);
    padding: 2px 8px;
    background-color: rgba(180, 160, 130, 0.3);
    border-radius: 4px;
}

.skill-desc {
    font-size: 12px;
    color: rgb(100, 80, 60);
    margin-top: 4px;
    white-space: normal;
}

.confirm-btn {
    margin-top: 12px;
    height: 44px;
    font-size: 18px;
    -unity-font-style: bold;
    background-color: rgb(180, 150, 100);
    color: rgb(60, 50, 40);
    border-width: 2px;
    border-color: rgb(120, 100, 80);
    border-radius: 6px;
}

.confirm-btn:hover {
    background-color: rgb(200, 170, 120);
}

.confirm-btn:disabled {
    background-color: rgb(160, 150, 140);
    color: rgb(120, 110, 100);
}
