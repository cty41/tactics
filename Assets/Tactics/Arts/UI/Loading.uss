.loading-screen {
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
    background-color: rgb(0, 0, 0);
}

.loading-text {
    position: absolute;
    right: 32px;
    bottom: 32px;
    color: rgb(255, 255, 255);
    font-size: 18px;
    -unity-text-align: middle-right;
}
