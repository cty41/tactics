.root-container {
    width: 100%;
    height: 100%;
    position: relative;
    background-color: rgb(12, 12, 14);
    justify-content: center;
    align-items: center;
}

.main-menu-panel {
    width: 360px;
    min-height: 420px;
    background-color: rgba(0, 0, 0, 0.91);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(249, 135, 75);
    padding: 36px 36px 40px 36px;
    flex-direction: column;
    align-items: center;
}

.game-title {
    font-size: 42px;
    color: white;
    -unity-text-align: middle-center;
    margin-bottom: 14px;
}

.menu-separator {
    width: 100%;
    height: 2px;
    background-color: rgb(249, 135, 75);
    margin-bottom: 18px;
}

.button {
    width: 180px;
    height: 48px;
    flex-grow: 0;
    flex-shrink: 0;
    background-color: rgba(0, 0, 0, 0.843);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(249, 135, 75);
    color: white;
    font-size: 18px;
    -unity-text-align: middle-center;
    cursor: arrow;
}

.button:hover {
    background-color: rgba(30, 30, 30, 0.9);
    border-color: rgb(255, 160, 100);
}

.button:active {
    background-color: rgba(50, 50, 50, 0.95);
}

.menu-button {
    width: 100%;
    margin-bottom: 12px;
}
