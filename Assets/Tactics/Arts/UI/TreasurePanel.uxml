<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Tactics/Arts/UI/TreasurePanel.uss?fileID=7433441132597879392&amp;guid=&amp;type=3#TreasurePanel"/>
    <ui:VisualElement name="TreasureOverlay" class="treasure-overlay">
        <ui:VisualElement name="TreasurePanel" class="treasure-panel">
            <ui:Label name="TreasureTitle" text="发现宝藏！" class="treasure-title"/>

            <ui:VisualElement name="RewardSection" class="reward-section">
                <ui:VisualElement name="GoldRow" class="reward-row">
                    <ui:Label text="💰" class="reward-icon"/>
                    <ui:Label name="GoldAmountLabel" text="+0 金币" class="gold-amount"/>
                </ui:VisualElement>

                <ui:VisualElement name="EquipmentRow" class="reward-row equipment-row" style="display: none;">
                    <ui:Label text="⚔️" class="reward-icon"/>
                    <ui:Label name="EquipmentLabel" text="" class="equipment-text"/>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:Button name="ConfirmButton" text="确认" class="confirm-btn"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
