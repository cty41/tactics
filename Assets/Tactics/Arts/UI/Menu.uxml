<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Tactics/Arts/UI/Menu.uss?fileID=7433441132597879392&amp;guid=713b5887f265e2e4a896f42bc7576a2a&amp;type=3#Menu"/>
    <ui:VisualElement name="PauseOverlay" class="pause-overlay">
        <ui:VisualElement name="MenuRoot" class="menu-root">
            <ui:Label name="MenuTitle" text="PAUSED" class="menu-title"/>
            <ui:Label name="MenuSubtitle" text="Game is paused" class="menu-subtitle"/>
            <ui:VisualElement name="MenuSeparator" class="menu-separator"/>
            <ui:Button name="ContinueButton" text="CONTINUE" class="menu-button"/>
            <ui:Button name="OptionsButton" text="OPTIONS" class="menu-button"/>
            <ui:Button name="MainMenuButton" text="MAIN MENU" class="menu-button"/>
            <ui:Button name="SaveAndQuitButton" text="SAVE AND QUIT" class="menu-button"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
