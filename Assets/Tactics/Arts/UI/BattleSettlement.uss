/* Battle Settlement UI Styles */

.battle-settlement-root {
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
    background-color: rgba(0, 0, 0, 0.7);
    padding: 24px;
}

.battle-settlement-panel {
    width: 100%;
    height: 100%;
    max-width: 800px;
    background-color: rgb(235, 222, 195);
    border-width: 4px;
    border-color: rgb(60, 50, 40);
    border-radius: 12px;
    flex-direction: column;
    padding: 24px;
    align-self: center;
}

/* Title */
.title-label {
    font-size: 28px;
    color: rgb(60, 50, 40);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 16px;
}

/* Result Section */
.result-section {
    width: 100%;
    flex-direction: column;
    align-items: center;
    padding: 16px;
    background-color: rgba(255, 255, 255, 0.3);
    border-width: 2px;
    border-color: rgb(180, 160, 130);
    border-radius: 8px;
    margin-bottom: 12px;
}

.result-label {
    font-size: 36px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.victory-label {
    color: rgb(200, 160, 40);
}

.defeat-label {
    color: rgb(180, 60, 60);
}

.rounds-label {
    font-size: 16px;
    color: rgb(100, 80, 60);
}

/* Experience Section */
.experience-section {
    width: 100%;
    flex-direction: column;
    padding: 12px;
    background-color: rgba(255, 255, 255, 0.3);
    border-width: 2px;
    border-color: rgb(180, 160, 130);
    border-radius: 8px;
    margin-bottom: 12px;
    flex-grow: 1;
    min-height: 120px;
}

.section-title {
    font-size: 18px;
    color: rgb(60, 50, 40);
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.experience-list {
    flex-grow: 1;
}

.experience-entry {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 6px 12px;
    background-color: rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    margin-bottom: 4px;
}

.exp-character-name {
    font-size: 16px;
    color: rgb(60, 50, 40);
    -unity-font-style: bold;
}

.exp-value {
    font-size: 16px;
    color: rgb(40, 120, 60);
    -unity-font-style: bold;
}

/* Gold Section */
.gold-section {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    background-color: rgba(255, 255, 255, 0.3);
    border-width: 2px;
    border-color: rgb(180, 160, 130);
    border-radius: 8px;
    margin-bottom: 16px;
}

.gold-label {
    font-size: 24px;
    color: rgb(200, 160, 40);
    -unity-font-style: bold;
}

/* Continue Button */
/* Character EXP Entry */
.character-exp-entry {
    width: 100%;
    flex-direction: column;
    padding: 10px 12px;
    background-color: rgba(255,255,255,0.25);
    border-radius: 6px;
    margin-bottom: 8px;
}
.char-info-row { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 4px; }
.char-name { font-size: 16px; color: rgb(60,50,40); -unity-font-style: bold; }
.char-level { font-size: 14px; color: rgb(120,100,60); }
.exp-bar-container { flex-direction: row; align-items: center; height: 18px; }
.exp-bar-bg { flex-grow: 1; height: 12px; background-color: rgb(200,180,150); border-radius: 6px; overflow: hidden; }
.exp-bar-fill { height: 100%; background-color: rgb(60,180,80); border-radius: 6px; }
.exp-text { font-size: 12px; color: rgb(100,80,60); margin-left: 8px; min-width: 80px; }
.exp-gained { font-size: 14px; color: rgb(40,150,60); -unity-font-style: bold; margin-top: 2px; }

.continue-button {
    width: 100%;
    height: 48px;
    background-color: rgb(60, 50, 40);
    border-width: 2px;
    border-color: rgb(40, 30, 20);
    border-radius: 8px;
    font-size: 20px;
    color: rgb(235, 222, 195);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.continue-button:hover {
    background-color: rgb(80, 70, 60);
}

.continue-button:active {
    background-color: rgb(40, 30, 20);
}
