/* Inventory UI Styles */

.inventory-root {
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
    background-color: rgba(0, 0, 0, 0.6);
    padding: 24px;
}

.inventory-panel {
    width: 100%;
    height: 100%;
    background-color: rgb(235, 222, 195);
    border-width: 4px;
    border-color: rgb(60, 50, 40);
    border-radius: 12px;
    flex-direction: column;
    padding: 16px;
}

/* Header */
.header {
    width: 100%;
    height: 40px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
}

.title-label {
    font-size: 24px;
    color: rgb(60, 50, 40);
    -unity-font-style: bold;
}

.close-button {
    width: 36px;
    height: 36px;
    background-color: rgb(180, 60, 60);
    border-width: 2px;
    border-color: rgb(60, 50, 40);
    border-radius: 6px;
    font-size: 20px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}

/* Content Area */
.content-area {
    width: 100%;
    flex-grow: 1;
    flex-direction: row;
}

/* Left Section */
.left-section {
    width: 40%;
    min-width: 360px;
    max-width: 560px;
    flex-direction: column;
    margin-right: 12px;
}

/* Equipment Area (Top Left) */
.equipment-area {
    flex-grow: 2;
    min-height: 48px;
    flex-direction: column;
    padding: 8px;
    background-color: rgba(255, 255, 255, 0.3);
    border-width: 2px;
    border-color: rgb(180, 160, 130);
    border-radius: 8px;
    margin-bottom: 8px;
}

.equipment-slots-grid {
    flex-wrap: wrap;
    justify-content: space-between;
}

.equipped-slot {
    width: 18%;
    height: 58px;
    background-color: rgba(180, 160, 130, 0.5);
    border-width: 2px;
    border-color: rgb(120, 100, 80);
    border-radius: 6px;
    margin-bottom: 6px;
}

.carried-consumable-row {
    width: 100%;
    height: 58px;
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
}

.carried-consumable-title {
    width: 72px;
    font-size: 15px;
    color: rgb(80, 60, 40);
    -unity-font-style: bold;
}

.carried-consumable-slot {
    width: 130px;
    height: 52px;
    background-color: rgba(180, 160, 130, 0.5);
    border-width: 2px;
    border-color: rgb(120, 100, 80);
    border-radius: 6px;
}

/* Character Section (Middle) - Only Portrait + Buttons */
.character-section {
    flex-grow: 2;
    min-height: 60px;
    flex-direction: column;
    align-items: center;
    padding: 8px;
    background-color: rgba(255, 255, 255, 0.3);
    border-width: 2px;
    border-color: rgb(180, 160, 130);
    border-radius: 8px;
    margin-bottom: 8px;
}

.portrait-small {
    width: 100px;
    height: 100px;
    background-color: rgba(180, 160, 130, 0.3);
    border-width: 2px;
    border-color: rgb(180, 160, 130);
    border-radius: 6px;
    margin-bottom: 6px;
    justify-content: center;
    align-items: center;
}

.portrait-placeholder {
    font-size: 16px;
    color: rgb(120, 100, 80);
}

.character-switch-buttons {
    width: 100%;
    flex-direction: row;
    justify-content: center;
    flex-wrap: wrap;
}

.character-switch-btn {
    width: 50px;
    height: 24px;
    background-color: rgba(180, 160, 130, 0.5);
    border-width: 2px;
    border-color: rgb(120, 100, 80);
    border-radius: 4px;
    font-size: 16px;
    color: rgb(60, 50, 40);
    -unity-text-align: middle-center;
    margin-right: 4px;
    margin-bottom: 4px;
}

.character-switch-btn.active {
    background-color: rgb(120, 100, 80);
    color: rgb(255, 255, 255);
}

/* Stats + Skills Row (Bottom) - 50% of left section height */
.stats-skills-row {
    flex-grow: 6;
    flex-direction: row;
    width: 100%;
}

.stats-column {
    width: 20%;
    flex-direction: column;
    padding: 8px;
    background-color: rgba(255, 255, 255, 0.3);
    border-width: 2px;
    border-color: rgb(180, 160, 130);
    border-radius: 8px;
    margin-right: 8px;
}

/* Character Info in Stats Column */
.character-info {
    margin-bottom: 8px;
}

.character-name-label {
    font-size: 16px;
    color: rgb(60, 50, 40);
    -unity-font-style: bold;
    margin-bottom: 2px;
}

.character-meta {
    flex-direction: row;
    margin-bottom: 4px;
}

.level-label {
    font-size: 16px;
    color: rgb(100, 80, 60);
    margin-right: 12px;
}

.hp-label {
    font-size: 16px;
    color: rgb(200, 60, 60);
}

.stat-row {
    width: 100%;
    height: 20px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-left: 6px;
    padding-right: 6px;
    background-color: rgba(255, 255, 255, 0.2);
    border-radius: 3px;
    margin-bottom: 2px;
}

.stat-label {
    font-size: 16px;
    color: rgb(80, 60, 40);
}

.stat-value {
    font-size: 16px;
    color: rgb(60, 50, 40);
    -unity-font-style: bold;
}

.skills-column {
    width: 80%;
    min-width: 120px;
    max-width: 280px;
    flex-direction: column;
    align-items: center;
    padding: 8px;
    background-color: rgba(255, 255, 255, 0.3);
    border-width: 2px;
    border-color: rgb(180, 160, 130);
    border-radius: 8px;
}

.section-title {
    font-size: 16px;
    color: rgb(60, 50, 40);
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.skill-slots {
    flex-direction: column;
    align-items: center;
}

.skill-slot {
    width: 44px;
    height: 44px;
    background-color: rgba(180, 160, 130, 0.5);
    border-width: 2px;
    border-color: rgb(120, 100, 80);
    border-radius: 6px;
    margin-bottom: 6px;
}

/* Storage Section (Center, Large) */
.storage-section {
    flex-grow: 1;
    flex-direction: column;
    padding: 8px;
    background-color: rgba(255, 255, 255, 0.3);
    border-width: 2px;
    border-color: rgb(180, 160, 130);
    border-radius: 8px;
}

.storage-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
}

.inventory-filters {
    flex-direction: row;
}

.inventory-filter {
    height: 28px;
    min-width: 64px;
    margin-left: 4px;
    background-color: rgba(180, 160, 130, 0.45);
    border-width: 1px;
    border-color: rgb(120, 100, 80);
    border-radius: 4px;
    color: rgb(60, 50, 40);
}

.inventory-filter.active {
    background-color: rgb(100, 75, 55);
    color: rgb(255, 245, 225);
}

.storage-scroll-view {
    width: 100%;
    flex-grow: 1;
}

.storage-grid-4col {
    width: 100%;
    flex-direction: row;
    flex-wrap: wrap;
}

.storage-slot-4col {
    width: 22%;
    height: 80px;
    background-color: rgba(180, 160, 130, 0.5);
    border-width: 2px;
    border-color: rgb(120, 100, 80);
    border-radius: 6px;
    margin-bottom: 8px;
}

.inventory-slot-label {
    width: 100%;
    height: 100%;
    font-size: 16px;
    color: rgb(45, 35, 28);
    -unity-text-align: middle-center;
    white-space: normal;
    overflow: hidden;
}

.inventory-slot-label.empty {
    color: rgb(120, 100, 80);
}

.inventory-item-popover {
    position: absolute;
    display: none;
    width: 320px;
    min-height: 230px;
    padding: 14px;
    background-color: rgb(42, 31, 28);
    border-width: 2px;
    border-color: rgb(159, 111, 53);
    border-radius: 8px;
}

.inventory-item-icon-box {
    width: 54px;
    height: 54px;
    align-self: center;
    justify-content: center;
    align-items: center;
    background-color: rgb(24, 18, 17);
    border-width: 1px;
    border-color: rgb(111, 78, 43);
    margin-bottom: 8px;
}

.inventory-item-icon {
    display: none;
    width: 48px;
    height: 48px;
}

.inventory-item-icon-placeholder {
    font-size: 24px;
    color: rgb(177, 137, 82);
}

.inventory-item-name {
    font-size: 20px;
    color: rgb(226, 190, 126);
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.inventory-item-meta {
    font-size: 14px;
    color: rgb(174, 149, 118);
    margin-bottom: 10px;
}

.inventory-item-description {
    min-height: 58px;
    font-size: 16px;
    color: rgb(225, 214, 194);
    white-space: normal;
    margin-bottom: 12px;
}

.inventory-item-action {
    height: 34px;
    background-color: rgb(116, 65, 41);
    border-width: 1px;
    border-color: rgb(188, 126, 61);
    border-radius: 4px;
    color: rgb(255, 239, 205);
    -unity-font-style: bold;
}
