/* Inventory UI Styles — 深色 + 橙边主题（与 Menu/Options/RoguelikeMap 统一） */

.inventory-root {
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
    background-color: rgba(0, 0, 0, 0.75);
    padding: 24px;
}

.inventory-panel {
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.94);
    border-width: 2px;
    border-color: rgb(249, 135, 75);
    border-radius: 12px;
    flex-direction: column;
    padding: 16px;
}

/* Header */
.header {
    width: 100%;
    height: 40px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
}

.title-label {
    font-size: 24px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.close-button {
    width: 36px;
    height: 36px;
    background-color: rgba(0, 0, 0, 0.84);
    border-width: 2px;
    border-color: rgb(249, 135, 75);
    border-radius: 8px;
    font-size: 20px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}

.close-button:hover {
    background-color: rgba(30, 30, 30, 0.9);
    border-color: rgb(255, 160, 100);
}

.close-button:active {
    background-color: rgba(50, 50, 50, 0.95);
}

/* Content Area */
.content-area {
    width: 100%;
    flex-grow: 1;
    flex-direction: row;
}

/* Left Section */
.left-section {
    width: 40%;
    min-width: 360px;
    max-width: 560px;
    flex-direction: column;
    margin-right: 12px;
}

/* Equipment Area (Top Left) */
.equipment-area {
    flex-grow: 2;
    min-height: 48px;
    flex-direction: column;
    padding: 8px;
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 1px;
    border-color: rgb(90, 90, 90);
    border-radius: 8px;
    margin-bottom: 8px;
}

.equipment-slots-grid {
    width: 100%;
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: flex-start;
    overflow: hidden;
}

/* 槽位基准尺寸 64px（与地图节点图标、party-avatar 一致） */
.equipped-slot {
    width: 64px;
    min-width: 64px;
    height: 64px;
    background-color: rgb(45, 45, 45);
    border-width: 2px;
    border-color: rgb(120, 120, 120);
    border-radius: 8px;
    margin-right: 6px;
}

.equipped-slot:hover {
    border-color: rgb(249, 135, 75);
}

.carried-consumable-row {
    width: 100%;
    height: 64px;
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
}

.carried-consumable-title {
    width: 72px;
    font-size: 15px;
    color: rgb(190, 190, 190);
    -unity-font-style: bold;
}

/* 槽内放"名称 + 充能"两行文本，保持较宽尺寸 */
.carried-consumable-slot {
    width: 120px;
    height: 64px;
    background-color: rgb(45, 45, 45);
    border-width: 2px;
    border-color: rgb(120, 120, 120);
    border-radius: 8px;
}

.carried-consumable-slot:hover {
    border-color: rgb(249, 135, 75);
}

/* Character Section (Middle) - Only Portrait + Buttons */
.character-section {
    flex-grow: 2;
    min-height: 60px;
    flex-direction: column;
    align-items: center;
    padding: 8px;
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 1px;
    border-color: rgb(90, 90, 90);
    border-radius: 8px;
    margin-bottom: 8px;
}

/* 立绘是视觉焦点，给橙边 */
.portrait-small {
    width: 100px;
    height: 100px;
    background-color: rgb(45, 45, 45);
    border-width: 2px;
    border-color: rgb(249, 135, 75);
    border-radius: 8px;
    margin-bottom: 6px;
    justify-content: center;
    align-items: center;
}

.portrait-placeholder {
    font-size: 16px;
    color: rgb(120, 120, 120);
}

.character-switch-buttons {
    width: 100%;
    flex-direction: row;
    justify-content: center;
    flex-wrap: wrap;
}

.character-switch-btn {
    height: 32px;
    min-width: 64px;
    padding-left: 10px;
    padding-right: 10px;
    background-color: rgba(0, 0, 0, 0.84);
    border-width: 1px;
    border-color: rgb(120, 120, 120);
    border-radius: 8px;
    font-size: 15px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    margin-right: 4px;
    margin-bottom: 4px;
}

.character-switch-btn:hover {
    background-color: rgba(30, 30, 30, 0.9);
    border-color: rgb(255, 160, 100);
}

.character-switch-btn.active {
    background-color: rgba(249, 135, 75, 0.25);
    border-color: rgb(249, 135, 75);
    color: rgb(255, 255, 255);
}

/* Stats + Skills Row (Bottom) - 50% of left section height */
.stats-skills-row {
    flex-grow: 6;
    flex-direction: row;
    width: 100%;
}

/* 属性列承载 6 行属性 + 角色信息，给足宽度 */
.stats-column {
    width: 55%;
    flex-direction: column;
    padding: 8px;
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 1px;
    border-color: rgb(90, 90, 90);
    border-radius: 8px;
    margin-right: 8px;
}

/* Character Info in Stats Column */
.character-info {
    margin-bottom: 8px;
}

.character-name-label {
    font-size: 16px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    margin-bottom: 2px;
}

.character-meta {
    flex-direction: row;
    margin-bottom: 4px;
}

.level-label {
    font-size: 16px;
    color: rgb(190, 190, 190);
    margin-right: 12px;
}

.hp-label {
    font-size: 16px;
    color: rgb(200, 60, 60);
}

.stat-row {
    width: 100%;
    height: 26px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-left: 6px;
    padding-right: 6px;
    background-color: rgba(255, 255, 255, 0.06);
    border-radius: 4px;
    margin-bottom: 2px;
}

.stat-label {
    font-size: 16px;
    color: rgb(190, 190, 190);
}

.stat-value {
    font-size: 16px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.skills-column {
    width: 45%;
    min-width: 120px;
    flex-direction: column;
    align-items: center;
    padding: 8px;
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 1px;
    border-color: rgb(90, 90, 90);
    border-radius: 8px;
}

.section-title {
    font-size: 16px;
    color: rgb(190, 190, 190);
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.skill-slots {
    width: 100%;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: flex-start;
    overflow: hidden;
}

.skill-slot {
    width: 64px;
    min-width: 64px;
    height: 64px;
    background-color: rgb(45, 45, 45);
    border-width: 2px;
    border-color: rgb(120, 120, 120);
    border-radius: 8px;
    margin-right: 6px;
}

.skill-slot:hover {
    border-color: rgb(249, 135, 75);
}

/* Storage Section (Center, Large) */
.storage-section {
    flex-grow: 1;
    flex-direction: column;
    padding: 8px;
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 1px;
    border-color: rgb(90, 90, 90);
    border-radius: 8px;
}

.storage-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
}

.inventory-filters {
    flex-direction: row;
}

.inventory-filter {
    height: 32px;
    min-width: 64px;
    margin-left: 4px;
    background-color: rgba(0, 0, 0, 0.84);
    border-width: 1px;
    border-color: rgb(120, 120, 120);
    border-radius: 8px;
    color: rgb(255, 255, 255);
}

.inventory-filter:hover {
    background-color: rgba(30, 30, 30, 0.9);
    border-color: rgb(255, 160, 100);
}

.inventory-filter.active {
    background-color: rgba(249, 135, 75, 0.25);
    border-color: rgb(249, 135, 75);
    color: rgb(255, 255, 255);
}

.storage-scroll-view {
    width: 100%;
    flex-grow: 1;
}

.storage-grid-4col {
    width: 100%;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

/* 正方形格子，4 列等距分布 */
.storage-slot-4col {
    width: 23%;
    aspect-ratio: 1;
    background-color: rgb(45, 45, 45);
    border-width: 2px;
    border-color: rgb(120, 120, 120);
    border-radius: 8px;
    margin-bottom: 8px;
}

.storage-slot-4col:hover {
    border-color: rgb(249, 135, 75);
}

.inventory-slot-label {
    width: 100%;
    height: 100%;
    font-size: 16px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    white-space: normal;
    overflow: hidden;
}

.inventory-slot-label.empty {
    color: rgb(120, 120, 120);
}

.inventory-item-popover {
    position: absolute;
    display: none;
    width: 320px;
    min-height: 230px;
    padding: 14px;
    background-color: rgb(20, 20, 20);
    border-width: 2px;
    border-color: rgb(249, 135, 75);
    border-radius: 8px;
}

.inventory-item-icon-box {
    width: 54px;
    height: 54px;
    align-self: center;
    justify-content: center;
    align-items: center;
    background-color: rgb(45, 45, 45);
    border-width: 1px;
    border-color: rgb(120, 120, 120);
    border-radius: 8px;
    margin-bottom: 8px;
}

.inventory-item-icon {
    display: none;
    width: 48px;
    height: 48px;
}

.inventory-item-icon-placeholder {
    font-size: 24px;
    color: rgb(190, 190, 190);
}

.inventory-item-name {
    font-size: 20px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.inventory-item-meta {
    font-size: 14px;
    color: rgb(190, 190, 190);
    margin-bottom: 10px;
}

.inventory-item-description {
    min-height: 58px;
    font-size: 16px;
    color: rgb(225, 225, 225);
    white-space: normal;
    margin-bottom: 12px;
}

.inventory-item-action {
    height: 34px;
    background-color: rgba(0, 0, 0, 0.84);
    border-width: 2px;
    border-color: rgb(249, 135, 75);
    border-radius: 8px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.inventory-item-action:hover {
    background-color: rgba(30, 30, 30, 0.9);
    border-color: rgb(255, 160, 100);
}

.inventory-item-action:active {
    background-color: rgba(50, 50, 50, 0.95);
}
