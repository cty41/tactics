<Project>
  <PropertyGroup>
    <GodotProjectDir>$(MSBuildThisFileDirectory)..\</GodotProjectDir>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)obj\</BaseIntermediateOutputPath>
    <IntermediateOutputPath>$(MSBuildThisFileDirectory)obj\$(Configuration)\</IntermediateOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Godot.NET.Sdk" Version="4.7.1" />
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Tactics.Godot.Adapter</RootNamespace>
    <AssemblyName>Tactics.Godot.Adapter</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath>..\Tactics.Godot.TestHost.packages.lock.json</NuGetLockFilePath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <!-- Keep the test host outside the Godot project root so GdUnit's mandatory
         root-level `dotnet build` resolves the single production project. -->
    <Compile Include="..\src\**\*.cs;..\addons\**\*.cs;**\*.cs;..\gdunit4_testadapter_v5\**\*.cs"
             Exclude=".godot\**\*.cs;bin\**\*.cs;obj\**\*.cs;gdunit4_testadapter_v5\**\*.cs" />
    <PackageReference Include="gdUnit4.api" Version="5.1.0-rc5" />
    <PackageReference Include="gdUnit4.test.adapter" Version="3.1.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <None Include="..\..\Tests\golden\10x10-core-vectors.json" Link="Golden\10x10-core-vectors.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Tests\golden\oracle-matrix.json" Link="Golden\oracle-matrix.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Tests\golden\contract-decisions.json" Link="Golden\contract-decisions.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Tests\golden\unit-batch-v1.json" Link="Golden\unit-batch-v1.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Tactics.Core\Tactics.Core.csproj" />
    <ProjectReference Include="..\..\src\Tactics.Application\Tactics.Application.csproj" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Godot.NET.Sdk" Version="4.7.1" />
</Project>
