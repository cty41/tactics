<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Tactics.Godot.Adapter</RootNamespace>
    <AssemblyName>Tactics.Godot.Adapter</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath>Tactics.Godot.TestHost.packages.lock.json</NuGetLockFilePath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <!-- Godot registers C# scripts from project.godot's configured assembly.
         The test host therefore builds the same production sources and assembly
         name, while keeping GdUnit packages and intermediates outside production. -->
    <Compile Include="src/**/*.cs;addons/**/*.cs;tests/**/*.cs;gdunit4_testadapter_v5/**/*.cs"
             Exclude="tests/.godot/**/*.cs;tests/bin/**/*.cs;tests/obj/**/*.cs;tests/gdunit4_testadapter_v5/**/*.cs" />
    <PackageReference Include="gdUnit4.api" Version="5.1.0-rc5" />
    <PackageReference Include="gdUnit4.test.adapter" Version="3.1.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <None Include="../Tests/golden/10x10-core-vectors.json" Link="Golden/10x10-core-vectors.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Tests/golden/oracle-matrix.json" Link="Golden/oracle-matrix.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Tests/golden/contract-decisions.json" Link="Golden/contract-decisions.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Tests/golden/unit-batch-v1.json" Link="Golden/unit-batch-v1.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\src\Tactics.Core\Tactics.Core.csproj" />
    <ProjectReference Include="..\src\Tactics.Application\Tactics.Application.csproj" />
  </ItemGroup>
</Project>
