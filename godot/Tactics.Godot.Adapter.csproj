<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Tactics.Godot.Adapter</RootNamespace>
    <AssemblyName>Tactics.Godot.Adapter</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/**/*.cs;addons/**/*.cs;tests/**/*.cs;gdunit4_testadapter_v5/**/*.cs" Exclude="tests/.godot/**/*.cs;tests/bin/**/*.cs;tests/obj/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\src\Tactics.Core\Tactics.Core.csproj" />
    <PackageReference Include="gdUnit4.api" Version="5.1.0-rc5" />
    <PackageReference Include="gdUnit4.test.adapter" Version="3.1.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
  </ItemGroup>
</Project>
