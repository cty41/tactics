<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Tactics.Godot.Adapter</RootNamespace>
    <AssemblyName>Tactics.Godot.Adapter</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
    <NuGetLockFilePath Condition="'$(Configuration)' == 'ExportDebug' Or '$(Configuration)' == 'ExportRelease'">packages.windows.lock.json</NuGetLockFilePath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'ExportRelease'">
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/**/*.cs;addons/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\src\Tactics.Core\Tactics.Core.csproj" />
    <ProjectReference Include="..\src\Tactics.Application\Tactics.Application.csproj" />
  </ItemGroup>
</Project>
