{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@mohak34/opencode-notifier@latest",
    "superpowers@git+https://github.com/obra/superpowers.git",
    "./.opencode/plugin/auto-compile.js"
  ],
  "mcp": {
    "unity-MCP": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "mcpforunityserver",
        "mcp-for-unity",
        "--transport",
        "stdio"
      ]
    }
  }
}
