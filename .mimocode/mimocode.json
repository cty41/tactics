{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["./.opencode/plugin/auto-compile.js"],
  "mcp": {
    "unity-MCP": {
      "type": "remote",
      "url": "http://127.0.0.1:8080/mcp"
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "ctx7sk-98e55a4c-13c8-4a61-92be-fcf503a43b43"
      },
      "enabled": true
    }
  },
  "lsp": {
    "csharp": {
      "command": ["roslyn-language-server", "--stdio"],
      "extensions": [".cs"]
    }
  }
}
